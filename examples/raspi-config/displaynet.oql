VERSION: 6
SCENARIO: Raspberry Pi raspi-config
CATEGORY: raspi-config
DESCRIPTION: DisplayNet host interfaces via raspi-config nonint.

CONFIG:
  NAME 'Raspberry Pi raspi-config'
  SET 'raspi.config.schemaVersion' "\"raspi-config-v1\""
  SET 'raspi.config.interfaces' "{\"camera\":false,\"i2c\":true,\"onewire\":false,\"spi\":false,\"ssh\":true,\"vnc\":false}"
  SET 'raspi.config.wifiCountry' "\"PL\""
