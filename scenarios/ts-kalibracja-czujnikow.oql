VERSION: 4
GOAL:
  SET NAME 'Kalibracja punktu zero'
  LOG 'TASK Resetuj czujnik ciśnienia'
  SET 'ciśnienie_ref' '0mbar'
  WAIT 5s
  SAMPLE ciśnienie_raw START 100ms
  WAIT 10s
  SAMPLE ciśnienie_raw STOP
  LOG 'CALC offset_zero = AVG ciśnienie_raw'
  LOG 'VAL offset_zero mbar'
  IF 'offset_zero' '-1 .. 1 mbar'
  CORRECT 'offset_zero w zakresie -1 .. 1 mbar'
  ERROR 'offset_zero poza zakresem -1 .. 1 mbar'
  IF 'offset_zero' > '1'
    CORRECT 'offset_zero w zakresie 1 .. ∞'
    ERROR 'offset_zero poza zakresem 1 .. ∞'
  ERROR 'Offset zero poza zakresem'
  SAVE offset_zero-kalibracja

GOAL:
  SET NAME 'Kalibracja punktu span'
  SET 'ciśnienie_ref' '1000mbar'
  SET 'źródło_ciśnienia' '1'
  WAIT 10s
  SAMPLE ciśnienie_raw START 100ms
  WAIT 10s
  SAMPLE ciśnienie_raw STOP
  LOG 'CALC span_measured = AVG ciśnienie_raw'
  LOG 'CALC span_error = DIFF span_measured ciśnienie_ref'
  LOG 'VAL span_measured mbar'
  LOG 'VAL span_error mbar'
  IF 'span_error' '-10 .. 10 mbar'
  CORRECT 'span_error w zakresie -10 .. 10 mbar'
  ERROR 'span_error poza zakresem -10 .. 10 mbar'
  IF 'span_error' > '10'
    CORRECT 'span_error w zakresie 10 .. ∞'
    ERROR 'span_error poza zakresem 10 .. ∞'
  ERROR 'Błąd span poza tolerancją'
  SET 'źródło_ciśnienia' '0'
  SAVE span_measured-kalibracja

GOAL:
  SET NAME 'Weryfikacja kalibracji'
  SET 'ciśnienie_ref' '500mbar'
  SET 'źródło_ciśnienia' '1'
  WAIT 5s
  LOG 'VAL ciśnienie_weryfikacja mbar'
  LOG 'CALC weryfikacja_error = DIFF ciśnienie_weryfikacja ciśnienie_ref'
  IF 'weryfikacja_error' '-5 .. 5 mbar'
  CORRECT 'weryfikacja_error w zakresie -5 .. 5 mbar'
  ERROR 'weryfikacja_error poza zakresem -5 .. 5 mbar'
  IF 'weryfikacja_error' > '5'
    CORRECT 'weryfikacja_error w zakresie 5 .. ∞'
    ERROR 'weryfikacja_error poza zakresem 5 .. ∞'
  ERROR 'Weryfikacja kalibracji negatywna'
  SET 'źródło_ciśnienia' '0'
  LOG 'TASK Generuj certyfikat kalibracji'
