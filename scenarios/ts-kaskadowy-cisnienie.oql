VERSION: 4
GOAL:
  SET NAME 'Inicjalizacja pomiaru kaskadowego'
  LOG 'TASK Kalibruj czujnik niskiego ciśnienia'
  LOG 'TASK Kalibruj czujnik średniego ciśnienia'
  SET próg_przełączenia = 50mbar
  SET czas_pomiaru_delta = 60s

GOAL:
  SET NAME 'Monitoring niskiego ciśnienia'
  SET czujnik_niskiego_ciśnienia 1
  SAMPLE ciśnienie_niskie START 100ms
  WAIT 5s
  LOG 'VAL ciśnienie_niskie mbar'
  IF 'ciśnienie_niskie' '-∞ .. próg_przełączenia'
    CORRECT 'ciśnienie_niskie poniżej progu przełączenia'
    ERROR 'ciśnienie_niskie powyżej progu przełączenia'
  LOG 'GOTO Pomiar delta na średnim ciśnieniu - NOT SUPPORTED IN V4'
  LOG 'ELSE INFO: 'Ciśnienie stabilne, kontynuuj monitoring' - NOT SUPPORTED IN V4'
  LOG 'GOTO Monitoring niskiego ciśnienia - NOT SUPPORTED IN V4'

GOAL:
  SET NAME 'Pomiar delta na średnim ciśnieniu'
  SET czujnik_niskiego_ciśnienia 0
  SET czujnik_średniego_ciśnienia 1
  SAMPLE ciśnienie_średnie START 100ms
  LOG 'VAL ciśnienie_start mbar'
  WAIT 60s
  SAMPLE ciśnienie_średnie STOP
  LOG 'VAL ciśnienie_koniec mbar'
  LOG 'CALC delta_ciśnienia = DIFF ciśnienie_start ciśnienie_koniec'
  LOG 'CALC ubytek_l_min = RATE ciśnienie_średnie l/min'
  LOG 'VAL ubytek_l_min l/min'
  IF 'ubytek_l_min' '0 .. 0.5 l/min'
  CORRECT 'ubytek_l_min w zakresie 0 .. 0.5 l/min'
  ERROR 'ubytek_l_min poza zakresem 0 .. 0.5 l/min'
  IF_DELTA 'ciśnienie_średnie' '60 s' '+0.5l/min'
  CORRECT 'ubytek_l_min w zakresie 0.5 .. ∞'
  ERROR 'ubytek_l_min poza zakresem 0.5 .. ∞'
  ERROR 'Zbyt duży ubytek: przekroczono 0.5 l/min'

GOAL:
  SET NAME 'Walidacja wyniku'
  LOG 'VAL ubytek_l_min l/min'
  IF 'ubytek_l_min' '-∞ .. 0.5'
  CORRECT 'ubytek_l_min w zakresie -∞ .. 0.5'
  ERROR 'ubytek_l_min poza zakresem -∞ .. 0.5'
  ERROR 'FAIL: Ubytek zbyt wysoki'
  SAVE wynik-protokół
