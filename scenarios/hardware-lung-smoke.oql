VERSION: 4
SCENARIO: Hardware Lung Smoke Test
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

GOAL:
  SET NAME 'smoke test tic249'
  LOG 'Uruchamiam silnik płuca'
  SET 'Pojemność płuca' '2.5l'
  SET 'Ilość cykli płuca' '20'
  SET 'Płuco' 'Start'
  REPEAT 10:
    SET WAIT '5 s'
    IF 'AI03' '-5 .. 5 V'
    REPEAT STOP
  LOG 'Zatrzymano'
