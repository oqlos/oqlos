VERSION: 5
SCENARIO: Test spadku ciśnienia automatu

GOAL:
  SET NAME 'test spadku ciśnienia'
  SET 'regulator' '50.0 l/min'
  SET 'pompa-1' '1'
  SAMPLE ciśnienie START 50ms
  SET WAIT '10 s'
  SAMPLE ciśnienie STOP
  SAVE dp-srednie
  RANGE 'ciśnienie' '0.5 mbar' .. '3.5 mbar'
  VAL 'ciśnienie' 'mbar'
  PASS 'Spadek ciśnienia automatu OK (0.5-3.5 mbar)'
  FAIL 'Błąd: spadek ciśnienia poza zakresem'
  SET 'pompa-1' '0'
