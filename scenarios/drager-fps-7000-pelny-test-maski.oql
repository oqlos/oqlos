VERSION: 4
GOAL:
  SET NAME 'TEST WIZUALNY'
  SET 'PUMP' 'off'
  SET 'Test wizualny' '1'
  SAVE 'Test wizualny'
  SET 'zawór 2' '1'
  SET 'PUMP' '5 l'
  SET 'WAIT' '7.0 s'
  SET 'zawór 6' '1'
  SET 'PUMP' '5 l'
  IF 'AI01' '-11.0 mbar' .. ∞'
    CORRECT 'AI01' w zakresie '-11.0 mbar' .. ∞'
    ERROR 'AI01' poza zakresem '-11.0 mbar' .. ∞'
  LOG 'VAL \'AI01\' \'mbar\'
  IF 'AI01' -999999 .. '-11.0 mbar' ELSE ERROR 'Wytworzenie  podciśnienia mbar'
  SET 'WAIT' '10.0 s'
  SET 'PUMP' 'off'
  SET 'WAIT' '10.0 s'
  SET 'zawór 4' '1'
  SET 'PUMP' 'off'
  IF 'AI01' '-∞ .. '-10.1 mbar'
    CORRECT 'AI01' w zakresie -∞ .. '-10.1 mbar'
    ERROR 'AI01' poza zakresem -∞ .. '-10.1 mbar'
  LOG 'VAL \'AI01\' \'mbar\'
  IF 'AI01' '-10.1 mbar' ELSE ERROR 'Ustawienie parametru Auto s' .. 999999
  SET 'WAIT' '20.0 s'
GOAL:
  SET NAME 'TEST SZCZELNOŚCI MASKI NADCIŚNIENIOWEJ'
  SET 'PUMP' 'off'
  IF 'AI01' '-∞ .. '-9.0 mbar'
    CORRECT 'AI01' w zakresie -∞ .. '-9.0 mbar'
    ERROR 'AI01' poza zakresem -∞ .. '-9.0 mbar'
  LOG 'VAL \'AI01\' \'mbar\'
  IF 'AI01' '-9.0 mbar' ELSE ERROR 'Test szczelności maski' .. 999999
  SAVE 'AI01'
  SET 'WAIT' '60.0 s'
  SET 'zawór 5' '1'
  SET 'PUMP' '10 l'
  SET 'WAIT' '5.0 s'
  SET 'zawór 5' '1'
  SET 'PUMP' '10 l'
  IF 'AI01' '4.2 mbar' .. '6.0 mbar'
    CORRECT 'AI01' w zakresie '4.2 mbar' .. '6.0 mbar'
    ERROR 'AI01' poza zakresem '4.2 mbar' .. '6.0 mbar'
  LOG 'VAL \'AI01\' \'mbar\'
  IF 'AI01' -999999 .. '4.2 mbar' ELSE ERROR 'Ciśnienie otwarcia zaworu wydechowego'
  SAVE 'AI01'
  SET 'WAIT' '1.0 s'
  SET 'zawór 3' '1'
  SET 'PUMP' '5 l'
  SET 'WAIT' '7.0 s'
