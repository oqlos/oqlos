VERSION: 5
SCENARIO: Test szczelności maski
CATEGORY: env

GOAL:
  SET NAME 'test szczelności'
  SET 'pompa-podciśnieniowa' '1'
  SET WAIT '60 s'
  RANGE 'szczelność' '95 %' .. '100 %'
  VAL 'szczelność' '%'
  PASS 'Szczelność maski OK (95-100%)'
  FAIL 'Błąd: szczelność maski poniżej 95%'
  GET szczelność
  SAVE szczelność-maska
  SET 'pompa-podciśnieniowa' '0'
