VERSION: 4
SCENARIO: Test szczelności maski
CATEGORY: env

GOAL:
  SET NAME 'test szczelności'
  SET 'pompa-podciśnieniowa' '1'
  SET WAIT '60 s'
  IF 'szczelność' '95 .. 100 %'
    CORRECT 'Szczelność maski OK (95-100%)'
    ERROR 'Błąd: szczelność maski poniżej 95%'
  GET szczelność
  SAVE szczelność-maska
  SET 'pompa-podciśnieniowa' '0'
