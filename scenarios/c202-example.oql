# C202 Example scenario
# Category: other

VERSION: 4
GOAL:
  SET NAME 'Kontrola Wizualna'
  LOG 'VAL \'wynik\' \'OK/NOK\'
GOAL:
  SET NAME 'Test Szczelności'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
  IF 'ciśnienie' 'NC' '-10 mbar' .. NC' '0 mbar'
    CORRECT 'ciśnienie w zakresie NC' '-10 mbar' .. NC' '0 mbar'
    ERROR 'ciśnienie poza zakresem NC' '-10 mbar' .. NC' '0 mbar'
  SAVE 'ciśnienie NC'
GOAL:
  SET NAME 'Test Szczelności (stary sposób)'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  SET 'timeout' '20 s'
  SET 'timer' '0 s'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
  IF 'ciśnienie' 'NC' '-10 mbar' .. NC' '0 mbar'
    CORRECT 'ciśnienie w zakresie NC' '-10 mbar' .. NC' '0 mbar'
    ERROR 'ciśnienie poza zakresem NC' '-10 mbar' .. NC' '0 mbar'
  SAVE 'ciśnienie NC'
  SET 'PUMP' 'off'
  SET 'zawór BO04' '0'
  SET 'zawór BO05' '0'
  SET 'zawór BO06' '0'
  SET 'timer' '0 s'
GOAL:
  SET NAME 'Ciśnienie otwarcia zaw. wyd.'
  LOG 'VAL \'ciśnienie\' \'bar\'
  IF 'ciśnienie' '11 bar' .. '12 bar'
    CORRECT 'ciśnienie' w zakresie '11 bar' .. '12 bar'
    ERROR 'ciśnienie' poza zakresem '11 bar' .. '12 bar'
GOAL:
  SET NAME 'Test nadciśnienia'
  SET 'timeout' '10 s'
  IF 'timer' 'timeout' .. 999999
  LOG 'VAL \'nadciśnienie\' \'mbar\'
  IF 'nadciśnienie' '2.0 mbar' .. '3.9 mbar'
    CORRECT 'nadciśnienie' w zakresie '2.0 mbar' .. '3.9 mbar'
    ERROR 'nadciśnienie' poza zakresem '2.0 mbar' .. '3.9 mbar'
  SAVE 'nadciśnienie'
