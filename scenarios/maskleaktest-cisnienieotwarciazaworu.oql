VERSION: 5
GOAL:
  SET NAME 'ciśnienie otwarcia zaworu wydechowego'
  # oczekiwany zakres: 4.2 – 6.0 mbar
  SET 'pompa-1' '5.0 l/min'
  SET 'valve-nc' '1'
  SET WAIT '1 s'
  RANGE 'AI01' '4.2 mbar' .. '6.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Ciśnienie otwarcia zaworu wydechowego OK (4.2-6.0 mbar)'
  FAIL 'Błąd: ciśnienie otwarcia poza zakresem 4.2-6.0 mbar'
  SAVE ciśnienie-otwarcia
