VERSION: 4
SCENARIO: PSS 7000 — Test przez maskę

GOAL:
  SET NAME 'Test wizualny'
  LOG 'Inspekcja wizualna aparatu'
  SAVE wynik-wizualny

GOAL:
  SET NAME 'Podłącz złącza SC'
  LOG 'Akcja manualna: podłącz złącza SC'

GOAL:
  SET NAME 'Otwórz zawór butli'
  SET 'zawór-butli-300bar' '1'

GOAL:
  SET NAME 'Załóż maskę'
  LOG 'Akcja manualna: załóż maskę'

GOAL:
  SET NAME 'Podłącz automat oddechowy'
  LOG 'Akcja manualna: podłącz automat oddechowy'

GOAL:
  SET NAME 'Test statyczny SC'
  SET 'pump-main' '0'
  SET WAIT '3 s'
  SAVE ciśnienie-sc
  IF 'AI02' '6.0 .. 8.0 bar'
  CORRECT 'Ciśnienie SC w normie (6-8 bar)'
  ERROR 'Błąd: ciśnienie SC poza zakresem 6-8 bar'

GOAL:
  SET NAME 'Zmiana SC'
  SET 'pump-main' '0'
  SET WAIT '60 s'
  SAVE delta-ciśnienia-sc
  IF 'AI02' '-0.3 .. 0.6 bar'
  CORRECT 'Delta ciśnienia SC w normie'
  ERROR 'Błąd: przekroczona delta ciśnienia SC (dopuszczalna -0.3 do 0.6 bar)'

GOAL:
  SET NAME 'Ciśnienie otwarcia automatu'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-bo06' '1'
  SET WAIT '8 s'
  SAVE ciśnienie-nc-min
  IF 'AI01' '-29.0 .. -5.0 mbar'
  CORRECT 'Ciśnienie otwarcia automatu w normie'
  ERROR 'Błąd: ciśnienie otwarcia automatu poza zakresem -29 do -5 mbar'

GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET 'pump-main' '0'
  SET WAIT '10 s'
  SAVE nadciśnienie
  IF 'nadcisnienie' '2.0 .. 3.9 mbar'
  CORRECT 'Nadciśnienie statyczne w normie (2.0-3.9 mbar)'
  ERROR 'Błąd: nadciśnienie poza zakresem 2.0-3.9 mbar'

GOAL:
  SET NAME 'Zamknij zawór butli'
  SET 'zawór-butli-300bar' '0'

GOAL:
  SET NAME 'Test szczelności WC'
  SET 'pump-main' '0'
  SET WAIT '5 s'
GOAL:
  SET NAME 'Kontrola spadku WC'
  SET WAIT '60 s'
  SAVE czas-pomiaru

GOAL:
  SET NAME 'Test sygnału akustycznego'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-bo06' '1'
  SET WAIT '2 s'
  SAVE wynik-sygnału
  IF 'AI01' '0.0 .. 1.0 mbar'
  CORRECT 'Sygnał akustyczny OK'
  ERROR 'Błąd: sygnał akustyczny poza zakresem'

GOAL:
  SET NAME 'Wyłącz automat oddechowy'
  SET 'automat-oddechowy' '0'

GOAL:
  SET NAME 'Wytworzenie podciśnienia'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-bo06' '1'
  SET WAIT '20 s'
  IF 'AI01' '-10.0 .. 10.0 mbar'
  CORRECT 'Podciśnienie w normie (-10 do 10 mbar)'
  ERROR 'Błąd: podciśnienie poza zakresem -10 do 10 mbar'

GOAL:
  SET NAME 'Szczelność automatu start'
  SET 'pump-main' '0'
  SET 'valve-bo04' '1'
  SET WAIT '15 s'
  SAVE ciśnienie-nc-początkowe
  IF 'AI01' '-12.0 .. -7.5 mbar'
  CORRECT 'Szczelność automatu start OK'
  ERROR 'Błąd: szczelność automatu start poza zakresem'

GOAL:
  SET NAME 'Szczelność automatu koniec'
  SET WAIT '60 s'
  SAVE ciśnienie-nc-końcowe
  IF 'AI01' '-10.0 .. -6.5 mbar'
  CORRECT 'Szczelność automatu koniec OK'
  ERROR 'Błąd: szczelność automatu koniec poza zakresem'
