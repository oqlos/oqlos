VERSION: 4
GOAL:
  SET NAME 'Przygotowanie testu wytrzymałości'
  LOG 'TASK Montuj próbka uchwyt testowy'
  LOG 'TASK Kalibruj czujnik siły'
  LOG 'TASK Kalibruj czujnik przemieszczenia'
  SET siła_max = 1000N
  SET cykle = 100
  SET prędkość = 10mm/s

GOAL:
  SET NAME 'Test cykliczny'
  SET cykl_aktualny = 0
  SET siłownik 1
  SET pozycja_docelowa = 50mm
  WAIT 1s
  LOG 'VAL siła_aktualna N'
  LOG 'VAL pozycja_aktualna mm'
  IF 'siła_aktualna' '0 .. 1100 N'
    CORRECT 'siła_aktualna w zakresie 0 .. 1100 N'
    ERROR 'siła_aktualna poza zakresem 0 .. 1100 N'
  ERROR 'Przekroczono maksymalną siłę'
  SET pozycja_docelowa = 0mm
  WAIT 1s
  LOG 'CALC cykl_aktualny = SUM cykl_aktualny 1'
  IF 'cykl_aktualny' '-∞ .. cykle'
  LOG 'GOTO Test cykliczny - NOT SUPPORTED IN V4'
  LOG 'ELSE INFO: 'Zakończono cykle testowe' - NOT SUPPORTED IN V4'

GOAL:
  SET NAME 'Ocena wyniku'
  LOG 'VAL cykle_wykonane szt'
  IF 'cykle_wykonane' '0 .. 100'
    CORRECT 'cykle_wykonane w zakresie 0 .. 100'
    ERROR 'cykle_wykonane poza zakresem 0 .. 100'
  ERROR 'Nie wykonano wymaganej liczby cykli'
  SET siłownik 0
  LOG 'TASK Generuj raport wytrzymałości'
