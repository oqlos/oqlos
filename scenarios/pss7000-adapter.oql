VERSION: 4
GOAL:
  SET NAME 'Test wizualny aparatu'
  VAL 'wynik' 'OK/NOK'
GOAL:
  SET NAME 'Podłącz złącza średniego ciśnienia'
GOAL:
  SET NAME 'Otwórz zawór butli'
GOAL:
  SET NAME 'Podłącz adapter'
GOAL:
  SET NAME 'Podłącz automat oddechowy'
GOAL:
  SET NAME 'Test statyczny średniego ciśnienia'
  SET 'PUMP' 'off'
  SET 'timeout' '3 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'ciśnienie SC' '6.0 bar'
  MAX 'ciśnienie SC' '8.0 bar'
  VAL 'ciśnienie SC' 'bar'
  SAVE 'ciśnienie SC'
GOAL:
  SET NAME 'Zmiana średniego ciśnienia po 1 min'
  SET 'PUMP' 'off'
  SET 'czas pomiaru' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas pomiaru'
  MIN 'delta ciśnienia SC' '-0.3 bar'
  MAX 'delta ciśnienia SC' '0.6 bar'
  VAL 'delta ciśnienia SC' 'bar'
  SAVE 'delta ciśnienia SC'
GOAL:
  SET NAME 'Ciśnienie otwarcia automatu oddechowego'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  SET 'timeout' '8 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'ciśnienie NC' '-29.0 mbar'
  MAX 'ciśnienie NC' '-5.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
  SAVE 'ciśnienie NC min'
GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET 'PUMP' 'off'
  SET 'timeout' '10 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'nadciśnienie' '2.0 mbar'
  MAX 'nadciśnienie' '3.9 mbar'
  VAL 'nadciśnienie' 'mbar'
  SAVE 'nadciśnienie'
GOAL:
  SET NAME 'Zamknij zawór butli'
  SET 'zawór butli 300 bar' '0'
GOAL:
  SET NAME 'Test szczelności układu WC'
  SET 'PUMP' 'off'
  SET 'czas obserwacji' '5 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas obserwacji'
  SAVE 'wynik operatora'
GOAL:
  SET NAME 'Kontrola spadku ciśnienia WC'
  SET 'czas pomiaru' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas pomiaru'
  MAX 'spadek ciśnienia' '10 bar'
  VAL 'spadek ciśnienia' 'bar'
  SAVE 'czas pomiaru'
GOAL:
  SET NAME 'Test sygnału akustycznego 50-60 bar'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  MIN 'ciśnienie NC' '0.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
  SAVE 'wynik sygnału'
GOAL:
  SET NAME 'Wyłącz automat oddechowy'
  SET 'automat oddechowy' 'off'
GOAL:
  SET NAME 'Wytworzenie nadciśnienia'
  SET 'PUMP' '5l'
  SET 'zawór BO05' '1'
  SET 'timeout' '20 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MAX 'ciśnienie NC' '12.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
GOAL:
  SET NAME 'Test szczelności automatu - pomiar początkowy'
  SET 'PUMP' 'off'
  SET 'zawór BO04' '1'
  SET 'timeout' '15 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'ciśnienie NC początkowe' '7.5 mbar'
  VAL 'ciśnienie NC' 'mbar'
GOAL:
  SET NAME 'Test szczelności automatu - pomiar końcowy'
  SET 'czas stabilizacji' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas stabilizacji'
  MIN 'ciśnienie NC końcowe' '6.5 mbar'
  VAL 'ciśnienie NC' 'mbar'
  IF 'ciśnienie NC' < '6.5 mbar'
  SAVE 'ciśnienie NC'

