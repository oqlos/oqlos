VERSION: 5
SCENARIO: PSS 7000 — Test przez adapter

GOAL:
  SET NAME 'Test wizualny'
  LOG 'Inspekcja wizualna aparatu'
  SAVE wynik-wizualny

GOAL:
  SET NAME 'Podłącz złącza SC'
  LOG 'Akcja manualna: podłącz złącza średniego ciśnienia'

GOAL:
  SET NAME 'Otwórz zawór butli'
  LOG 'Akcja manualna: otwórz zawór butli'

GOAL:
  SET NAME 'Podłącz adapter'
  LOG 'Akcja manualna: podłącz adapter'

GOAL:
  SET NAME 'Podłącz automat oddechowy'
  LOG 'Akcja manualna: podłącz automat oddechowy'

GOAL:
  SET NAME 'Test statyczny SC'
  SET 'pump-main' '0'
  SET WAIT '3 s'
  SAVE ciśnienie-sc
  RANGE 'AI02' '6.0 bar' .. '8.0 bar'
  VAL 'AI02' 'bar'
  PASS 'Ciśnienie SC w normie (6-8 bar) - adapter'
  FAIL 'Błąd: ciśnienie SC poza zakresem 6-8 bar (adapter)'

GOAL:
  SET NAME 'Zmiana SC po 1 min'
  SET 'pump-main' '0'
  SET WAIT '60 s'
  SAVE delta-ciśnienia-sc
  RANGE 'AI02' '-0.3 bar' .. '0.6 bar'
  VAL 'AI02' 'bar'
  PASS 'Delta ciśnienia SC w normie (adapter)'
  FAIL 'Błąd: przekroczona delta ciśnienia SC (adapter)'

GOAL:
  SET NAME 'Ciśnienie otwarcia automatu'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-bo06' '1'
  SET WAIT '8 s'
  SAVE ciśnienie-nc-min
  RANGE 'AI01' '-29.0 mbar' .. '-5.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Ciśnienie otwarcia automatu w normie (adapter)'
  FAIL 'Błąd: ciśnienie otwarcia poza zakresem (adapter)'

GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET 'pump-main' '0'
  SET WAIT '10 s'
  SAVE nadciśnienie
  RANGE 'nadcisnienie' '2.0 mbar' .. '3.9 mbar'
  VAL 'nadcisnienie' 'mbar'
  PASS 'Nadciśnienie statyczne w normie (adapter)'
  FAIL 'Błąd: nadciśnienie poza zakresem (adapter)'

GOAL:
  SET NAME 'Zamknij zawór butli'
  SET 'zawór-butli-300bar' '0'

GOAL:
  SET NAME 'Test szczelności WC'
  SET 'pump-main' '0'
  SET WAIT '5 s'
  SAVE wynik-operatora

GOAL:
  SET NAME 'Kontrola spadku WC'
  SET WAIT '60 s'
  SAVE spadek-ciśnienia
  RANGE 'spadek-ciśnienia' '0.0 bar' .. '10.0 bar'
  VAL 'spadek-ciśnienia' 'bar'
  PASS 'Spadek WC w normie'
  FAIL 'Błąd: spadek WC poza zakresem'

GOAL:
  SET NAME 'Test sygnału akustycznego'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-bo06' '1'
  SET WAIT '2 s'
  SAVE wynik-sygnału
  RANGE 'AI01' '0.0 mbar' .. '1.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Sygnał akustyczny OK'
  FAIL 'Błąd: sygnał akustyczny poza zakresem'

GOAL:
  SET NAME 'Wyłącz automat oddechowy'
  SET 'automat-oddechowy' '0'

GOAL:
  SET NAME 'Wytworzenie nadciśnienia'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-bo05' '1'
  SET WAIT '20 s'
  RANGE 'AI01' '0.0 mbar' .. '12.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Nadciśnienie w normie'
  FAIL 'Błąd: nadciśnienie poza zakresem'

GOAL:
  SET NAME 'Szczelność automatu start'
  SET 'pump-main' '0'
  SET 'valve-bo04' '1'
  SET WAIT '15 s'
  SAVE ciśnienie-nc-początkowe
  RANGE 'AI01' '7.5 mbar' .. '9.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Szczelność automatu start OK'
  FAIL 'Błąd: szczelność automatu start poza zakresem'

GOAL:
  SET NAME 'Szczelność automatu koniec'
  SET WAIT '60 s'
  SAVE ciśnienie-nc-końcowe
  RANGE 'AI01' '6.5 mbar' .. '8.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Szczelność automatu koniec OK'
  FAIL 'Błąd: szczelność automatu koniec poza zakresem'
