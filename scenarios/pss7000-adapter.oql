VERSION: 4
GOAL:
  SET NAME 'Test wizualny aparatu'
  LOG 'VAL \'wynik\' \'OK/NOK\'
GOAL:
  SET NAME 'Podłącz złącza średniego ciśnienia'
GOAL:
  SET NAME 'Otwórz zawór butli'
GOAL:
  SET NAME 'Podłącz adapter'
GOAL:
  SET NAME 'Podłącz automat oddechowy'
GOAL:
  SET NAME 'Test statyczny średniego ciśnienia'
  SET 'PUMP' 'off'
  SET 'timeout' '3 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'ciśnienie' 'SC' '6.0 bar' .. SC' '8.0 bar'
    CORRECT 'ciśnienie w zakresie SC' '6.0 bar' .. SC' '8.0 bar'
    ERROR 'ciśnienie poza zakresem SC' '6.0 bar' .. SC' '8.0 bar'
  LOG 'VAL \'ciśnienie SC\' \'bar\'
  SAVE 'ciśnienie SC'
GOAL:
  SET NAME 'Zmiana średniego ciśnienia po 1 min'
  SET 'PUMP' 'off'
  SET 'czas pomiaru' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT'_'timer = czas pomiaru'
  IF 'delta' 'ciśnienia SC' '-0.3 bar' .. ciśnienia SC' '0.6 bar'
    CORRECT 'delta w zakresie ciśnienia SC' '-0.3 bar' .. ciśnienia SC' '0.6 bar'
    ERROR 'delta poza zakresem ciśnienia SC' '-0.3 bar' .. ciśnienia SC' '0.6 bar'
  LOG 'VAL \'delta ciśnienia SC\' \'bar\'
  SAVE 'delta ciśnienia SC'
GOAL:
  SET NAME 'Ciśnienie otwarcia automatu oddechowego'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  SET 'timeout' '8 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'ciśnienie' 'NC' '-29.0 mbar' .. NC' '-5.0 mbar'
    CORRECT 'ciśnienie w zakresie NC' '-29.0 mbar' .. NC' '-5.0 mbar'
    ERROR 'ciśnienie poza zakresem NC' '-29.0 mbar' .. NC' '-5.0 mbar'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
  SAVE 'ciśnienie NC min'
GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET 'PUMP' 'off'
  SET 'timeout' '10 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'nadciśnienie' '2.0 mbar' .. '3.9 mbar'
    CORRECT 'nadciśnienie' w zakresie '2.0 mbar' .. '3.9 mbar'
    ERROR 'nadciśnienie' poza zakresem '2.0 mbar' .. '3.9 mbar'
  LOG 'VAL \'nadciśnienie\' \'mbar\'
  SAVE 'nadciśnienie'
GOAL:
  SET NAME 'Zamknij zawór butli'
  SET 'zawór butli 300 bar' '0'
GOAL:
  SET NAME 'Test szczelności układu WC'
  SET 'PUMP' 'off'
  SET 'czas obserwacji' '5 s'
  SET 'timer' '0 s'
  SET 'WAIT'_'timer = czas obserwacji'
  SAVE 'wynik operatora'
GOAL:
  SET NAME 'Kontrola spadku ciśnienia WC'
  SET 'czas pomiaru' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT'_'timer = czas pomiaru'
  IF 'spadek' '-∞ .. ciśnienia' '10 bar'
    CORRECT 'spadek w zakresie -∞ .. ciśnienia' '10 bar'
    ERROR 'spadek poza zakresem -∞ .. ciśnienia' '10 bar'
  LOG 'VAL \'spadek ciśnienia\' \'bar\'
  SAVE 'czas pomiaru'
GOAL:
  SET NAME 'Test sygnału akustycznego 50-60 bar'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  IF 'ciśnienie' 'NC' '0.0 mbar' .. ∞'
    CORRECT 'ciśnienie w zakresie NC' '0.0 mbar' .. ∞'
    ERROR 'ciśnienie poza zakresem NC' '0.0 mbar' .. ∞'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
  SAVE 'wynik sygnału'
GOAL:
  SET NAME 'Wyłącz automat oddechowy'
  SET 'automat oddechowy' 'off'
GOAL:
  SET NAME 'Wytworzenie nadciśnienia'
  SET 'PUMP' '5l'
  SET 'zawór BO05' '1'
  SET 'timeout' '20 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'ciśnienie' '-∞ .. NC' '12.0 mbar'
    CORRECT 'ciśnienie w zakresie -∞ .. NC' '12.0 mbar'
    ERROR 'ciśnienie poza zakresem -∞ .. NC' '12.0 mbar'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
GOAL:
  SET NAME 'Test szczelności automatu - pomiar początkowy'
  SET 'PUMP' 'off'
  SET 'zawór BO04' '1'
  SET 'timeout' '15 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'ciśnienie' 'NC początkowe' '7.5 mbar' .. ∞'
    CORRECT 'ciśnienie w zakresie NC początkowe' '7.5 mbar' .. ∞'
    ERROR 'ciśnienie poza zakresem NC początkowe' '7.5 mbar' .. ∞'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
GOAL:
  SET NAME 'Test szczelności automatu - pomiar końcowy'
  SET 'czas stabilizacji' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT'_'timer = czas stabilizacji'
  IF 'ciśnienie' 'NC końcowe' '6.5 mbar' .. ∞'
    CORRECT 'ciśnienie w zakresie NC końcowe' '6.5 mbar' .. ∞'
    ERROR 'ciśnienie poza zakresem NC końcowe' '6.5 mbar' .. ∞'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
  IF 'ciśnienie_NC' -999999 .. '6.5 mbar'
  SAVE 'ciśnienie NC'
