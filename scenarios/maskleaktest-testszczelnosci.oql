VERSION: 4
GOAL:
  SET NAME 'Wytworzenie podciśnienia -10 mbar i obserwacja przez 60 sekund'
  SET 'Pump' 'set'
  SET 'Valve' 'NC'
  WAIT '2000 ms'
  IF 'AI01' > '-11.0 mbar'
    CORRECT 'AI01' w zakresie '-11.0 mbar' .. ∞'
    ERROR 'AI01' poza zakresem '-11.0 mbar' .. ∞'
  SAVE 'AI01.value'
  SET 'Pump' 'off'
  IF 'AI01' > '-11.0 mbar'
    CORRECT 'AI01' w zakresie '-11.0 mbar' .. ∞'
    ERROR 'AI01' poza zakresem '-11.0 mbar' .. ∞'
  SAVE 'AI01.value'
