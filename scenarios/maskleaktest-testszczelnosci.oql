VERSION: 5
GOAL:
  SET NAME 'test szczelności maska'
  # wytworzenie podciśnienia -10 mbar, obserwacja 60 s
  SET 'pompa-1' '5.0 l/min'
  SET 'valve-nc' '1'
  SET WAIT '2 s'
  RANGE 'AI01' '-11.0 mbar' .. '-9.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Podciśnienie startowe OK (-11 do -9 mbar)'
  FAIL 'Błąd: podciśnienie startowe poza zakresem'
  SAVE podciśnienie-start
  SET 'pompa-1' '0 l/min'
  SET WAIT '60 s'
  RANGE 'AI01' '-11.0 mbar' .. '-9.0 mbar'
  PASS 'Szczelność maski OK (po 60s)'
  FAIL 'Błąd: nieszczelność maski (spadek podciśnienia)'
  SAVE podciśnienie-koniec
