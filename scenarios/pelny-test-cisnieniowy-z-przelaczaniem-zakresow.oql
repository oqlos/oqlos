VERSION: 5
SCENARIO: Pełny test ciśnieniowy z przełączaniem zakresów
DESCRIPTION: Sekwencja próżnia -> niskie -> wysokie ciśnienie.

CONFIG przygotowanie:
  SET 'pompa-próżniowa' '1'
  SET 'pompa-ciśnieniowa' '1'
  SET 'czujnik-próżni' '1'
  SET 'czujnik-niskiego-ciśnienia' '1'
  SET 'czujnik-wysokiego-ciśnienia' '1'
  SET 'zawór-izolacyjny' '1'

GOAL:
  SET NAME 'test próżni'
  SET 'pompa-próżniowa' '1'
  SAMPLE ciśnienie START 50ms
  SET WAIT '30 s'
  SAMPLE ciśnienie STOP
  SAVE p-prozni
  RANGE 'ciśnienie' '-1000 mbar' .. '-900 mbar'
  VAL 'ciśnienie' 'mbar'
  PASS 'Próżnia w normie (-1000 do -900 mbar)'
  FAIL 'Błąd: próżnia poza zakresem -1000 do -900 mbar'
  SET 'pompa-próżniowa' '0'

GOAL:
  SET NAME 'test niskiego ciśnienia'
  SET 'pompa-ciśnieniowa' '1'
  SET WAIT '10 s'
  SAVE cn
  RANGE 'ciśnienie-niskie' '25 mbar' .. '35 mbar'
  VAL 'ciśnienie-niskie' 'mbar'
  PASS 'Niskie ciśnienie w normie (25-35 mbar)'
  FAIL 'Błąd: niskie ciśnienie poza zakresem 25-35 mbar'

GOAL:
  SET NAME 'test wysokiego ciśnienia'
  SET 'multiplekser' '2'
  SET WAIT '10 s'
  SAVE cw
  RANGE 'ciśnienie-wysokie' '480 mbar' .. '520 mbar'
  VAL 'ciśnienie-wysokie' 'mbar'
  PASS 'Wysokie ciśnienie w normie (480-520 mbar)'
  FAIL 'Błąd: wysokie ciśnienie poza zakresem 480-520 mbar'
  SET 'pompa-ciśnieniowa' '0'
  SET 'zawór-izolacyjny' '0'

GOAL:
  SET NAME 'podsumowanie'
  LOG 'Test ciśnieniowy zakończony'
  SAVE raport-pełny
