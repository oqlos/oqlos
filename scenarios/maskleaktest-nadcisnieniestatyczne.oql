VERSION: 5
GOAL:
  SET NAME 'nadciśnienie statyczne maska'
  # oczekiwany zakres: 1.0 – 3.9 mbar
  SET 'pompa-1' '5.0 l/min'
  SET 'valve-nc' '1'
  SET WAIT '3 s'
  RANGE 'AI01' '1.0 mbar' .. '3.9 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Nadciśnienie statyczne maski OK (1.0-3.9 mbar)'
  FAIL 'Błąd: nadciśnienie statyczne poza zakresem'
  SAVE nadciśnienie-statyczne
