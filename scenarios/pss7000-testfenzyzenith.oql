VERSION: 5
SCENARIO: PSS 7000 + FENZY ZENITH — test szczelności automatu

GOAL:
  SET NAME 'Faza 1: Statyczne SC'
  SET 'pump-main' '0'
  SET WAIT '3 s'
  RANGE 'AI02' '6.0 bar' .. '10.0 bar'
  VAL 'AI02' 'bar'
  PASS 'Ciśnienie SC w normie (6-10 bar)'
  FAIL 'Błąd: ciśnienie SC poza zakresem'

GOAL:
  SET NAME 'Faza 2: Delta SC'
  SET WAIT '3 s'
  RANGE 'AI02' '-1.0 bar' .. '0.5 bar'
  VAL 'AI02' 'bar'
  PASS 'Delta ciśnienia SC w normie'
  FAIL 'Błąd: delta ciśnienia SC poza zakresem'

GOAL:
  SET NAME 'Faza 3: Nadciśnienie'
  SET 'pump-main' '0'
  SET WAIT '5 s'
  RANGE 'AI01' '2.2 mbar' .. '4.2 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Nadciśnienie w normie'
  FAIL 'Błąd: nadciśnienie poza zakresem'

GOAL:
  SET NAME 'Faza 4: Sygnał akustyczny'
  SET 'pump-main' '5 l/min'
  SET 'valve-nc' '1'
  SET WAIT '2 s'
  RANGE 'AI01' '0.0 mbar' .. '1.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Sygnał akustyczny OK'
  FAIL 'Błąd: sygnał akustyczny poza zakresem'
  SAVE wynik-operatora

GOAL:
  SET NAME 'Faza 5: Podciśnienie'
  SET 'pump-main' '5 l/min'
  SET 'valve-nc' '1'
  SET WAIT '20 s'
  RANGE 'AI01' '-15.0 mbar' .. '-12.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Podciśnienie w normie'
  FAIL 'Błąd: podciśnienie poza zakresem'

GOAL:
  SET NAME 'Faza 6: Szczelność'
  SET 'pump-main' '0'
  SET 'valve-nc' '0'
  SET WAIT '15 s'
  RANGE 'AI01' '-8.0 mbar' .. '-4.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Szczelność OK'
  FAIL 'Błąd: szczelność poza zakresem'
