VERSION: 4
GOAL:
  SET NAME 'Pełny test maski'
  SET 'Pump' 'off'
  SET 'Operator' 'confirm'
  SAVE 'operator.result'
  SET 'BO02' 'on'
  SET 'Pump' 'set'
  IF 'Timer' ≤ '7.0'
  SET 'BO06' 'on'
  SET 'Pump' 'set'
  IF 'AI01' ≥ '-11.0'
  IF 'Timer' ≤ '10.0'
  SET 'Pump' 'off'
  IF 'Timer' ≤ '10.0'
  SET 'BO04' 'on'
  SET 'Pump' 'off'
  IF 'AI01' ≤ '-10.1'
  IF 'Timer' ≤ '20.0'
  SET 'Pump' 'off'
  IF 'AI01' ≤ '-9.0'
  SAVE 'AI01.value'
  IF 'Timer' ≤ '60.0'
  SET 'BO05' 'on'
  SET 'Pump' 'set'
  IF 'Timer' ≤ '5.0'
  SET 'BO05' 'on'
  SET 'Pump' 'set'
  IF 'AI01' > '4.2 mbar'
    CORRECT 'AI01' w zakresie '4.2 mbar' .. ∞'
    ERROR 'AI01' poza zakresem '4.2 mbar' .. ∞'
  SAVE 'AI01.value'
  SET 'BO03' 'on'
  SET 'Pump' 'set'
  IF 'Timer' ≤ '7.0'
