VERSION: 5
SCENARIO: Test wytrzymałości mechanicznej
DESCRIPTION: Pojedynczy cykl obciążenia/odciążenia — pętla cykli jest sterowana z zewnątrz.

CONFIG przygotowanie:
  SET 'próbka' '1'
  SET 'czujnik-siły' '1'
  SET 'czujnik-przemieszczenia' '1'

GOAL:
  SET NAME 'Cykl pojedynczy'
  SET 'siłownik' '1'
  SET 'pozycja-docelowa' '50 mm'
  SET WAIT '1 s'
  GET siła-aktualna
  SAVE siła-aktualna
  GET pozycja-aktualna
  SAVE pozycja-aktualna
  RANGE 'siła-aktualna' '0 N' .. '1100 N'
  VAL 'siła-aktualna' 'N'
  PASS 'Siła w zakresie wytrzymałości (0-1100 N)'
  FAIL 'Błąd: siła poza zakresem wytrzymałości'
  SET 'pozycja-docelowa' '0 mm'
  SET WAIT '1 s'
GOAL:
  SET NAME 'Ocena wyniku'
  RANGE 'cykle-wykonane' '100 szt' .. '1000 szt'
  VAL 'cykle-wykonane' 'szt'
  PASS 'Liczba cykli w normie'
  FAIL 'Błąd: liczba cykli poniżej minimum'
  SET 'siłownik' '0'
  SAVE raport-wytrzymałości
