VERSION: 4
GOAL:
  SET NAME 'Test wizualny aparatu'
  LOG 'VAL \'wynik\' \'OK/NOK\'
  SAVE 'wynik'
GOAL:
  SET NAME 'Podłącz złącza SC'
GOAL:
  SET NAME 'Odkręć zawór butli'
  SET 'zawór butli 300 bar' '1'
GOAL:
  SET NAME 'Załóż maskę FENZY ZENITH'
GOAL:
  SET NAME 'Test statyczny średniego ciśnienia'
  SET 'PUMP' 'off'
  SET 'timeout' '3 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'ciśnienie' 'SC' '6.0 bar' .. SC' '8.0 bar'
    CORRECT 'ciśnienie w zakresie SC' '6.0 bar' .. SC' '8.0 bar'
    ERROR 'ciśnienie poza zakresem SC' '6.0 bar' .. SC' '8.0 bar'
  LOG 'VAL \'ciśnienie SC\' \'bar\'
  SAVE 'ciśnienie SC'
GOAL:
  SET NAME 'Zmiana średniego ciśnienia'
  SET 'czas pomiaru' '60 s'
  SET 'timer' '0 s'
  WAIT 60s
  IF 'delta' 'ciśnienia SC' '-1.0 bar' .. ciśnienia SC' '0.5 bar'
    CORRECT 'delta w zakresie ciśnienia SC' '-1.0 bar' .. ciśnienia SC' '0.5 bar'
    ERROR 'delta poza zakresem ciśnienia SC' '-1.0 bar' .. ciśnienia SC' '0.5 bar'
  LOG 'VAL \'delta ciśnienia SC\' \'bar\'
  SAVE 'delta ciśnienia SC'
GOAL:
  SET NAME 'Zamknij zawór butli'
  SET 'zawór butli 300 bar' '0'
GOAL:
  SET NAME 'Test szczelności układu WC'
  SET 'PUMP' 'off'
  SET 'czas obserwacji' '5 s'
  SET 'timer' '0 s'
  WAIT 5s
GOAL:
  SET NAME 'Kontrola spadku ciśnienia (max 3 bar/10s)'
  SET 'czas pomiaru' '10 s'
  SET 'timer' '0 s'
  WAIT 10s
  IF 'spadek' '-∞ .. ciśnienia' '3 bar'
    CORRECT 'spadek w zakresie -∞ .. ciśnienia' '3 bar'
    ERROR 'spadek poza zakresem -∞ .. ciśnienia' '3 bar'
  LOG 'VAL \'spadek ciśnienia\' \'bar\'
  SAVE 'czas pomiaru'
GOAL:
  SET NAME 'Podłącz automat oddechowy'
GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET 'PUMP' 'off'
  SET 'timeout' '5 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'nadciśnienie' '2.2 mbar' .. '4.1 mbar'
    CORRECT 'nadciśnienie' w zakresie '2.2 mbar' .. '4.1 mbar'
    ERROR 'nadciśnienie' poza zakresem '2.2 mbar' .. '4.1 mbar'
  LOG 'VAL \'nadciśnienie\' \'mbar\'
  SAVE 'nadciśnienie'
GOAL:
  SET NAME 'Test sygnału akustycznego'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  IF 'ciśnienie' 'NC' '0.0 mbar' .. ∞'
    CORRECT 'ciśnienie w zakresie NC' '0.0 mbar' .. ∞'
    ERROR 'ciśnienie poza zakresem NC' '0.0 mbar' .. ∞'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
  SAVE 'wynik sygnału'
GOAL:
  SET NAME 'Wytworzenie podciśnienia'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  SET 'timeout' '20 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'ciśnienie' 'NC' '-12.0 mbar' .. NC' '12.0 mbar'
    CORRECT 'ciśnienie w zakresie NC' '-12.0 mbar' .. NC' '12.0 mbar'
    ERROR 'ciśnienie poza zakresem NC' '-12.0 mbar' .. NC' '12.0 mbar'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
GOAL:
  SET NAME 'Ustawienie parametru AUTO'
  SET 'PUMP' 'off'
  SET 'zawór BO04' '1'
  SET 'timeout' '15 s'
  SET 'timer' '0 s'
  IF 'timer' 'timeout' .. 999999
  IF 'ciśnienie' '-∞ .. NC' '-6.0 mbar'
    CORRECT 'ciśnienie w zakresie -∞ .. NC' '-6.0 mbar'
    ERROR 'ciśnienie poza zakresem -∞ .. NC' '-6.0 mbar'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
GOAL:
  SET NAME 'Test szczelności automatu oddechowego'
  SET 'czas stabilizacji' '5 s'
  SET 'timer' '0 s'
  WAIT 5s
  IF 'ciśnienie' '-∞ .. NC końcowe' '-4.0 mbar'
    CORRECT 'ciśnienie w zakresie -∞ .. NC końcowe' '-4.0 mbar'
    ERROR 'ciśnienie poza zakresem -∞ .. NC końcowe' '-4.0 mbar'
  LOG 'VAL \'ciśnienie NC\' \'mbar\'
  IF 'ciśnienie_NC' '-4.0 mbar' .. 999999
  SAVE 'ciśnienie NC'
