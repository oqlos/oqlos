VERSION: 4
GOAL:
  SET NAME 'Test wizualny aparatu'
  VAL 'wynik' 'OK/NOK'
  SAVE 'wynik'
GOAL:
  SET NAME 'Podłącz złącza SC'
GOAL:
  SET NAME 'Odkręć zawór butli'
  SET 'zawór butli 300 bar' '1'
GOAL:
  SET NAME 'Załóż maskę FENZY ZENITH'
GOAL:
  SET NAME 'Test statyczny średniego ciśnienia'
  SET 'PUMP' 'off'
  SET 'timeout' '3 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'ciśnienie SC' '6.0 bar'
  MAX 'ciśnienie SC' '8.0 bar'
  VAL 'ciśnienie SC' 'bar'
  SAVE 'ciśnienie SC'
GOAL:
  SET NAME 'Zmiana średniego ciśnienia'
  SET 'czas pomiaru' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas pomiaru'
  MIN 'delta ciśnienia SC' '-1.0 bar'
  MAX 'delta ciśnienia SC' '0.5 bar'
  VAL 'delta ciśnienia SC' 'bar'
  SAVE 'delta ciśnienia SC'
GOAL:
  SET NAME 'Zamknij zawór butli'
  SET 'zawór butli 300 bar' '0'
GOAL:
  SET NAME 'Test szczelności układu WC'
  SET 'PUMP' 'off'
  SET 'czas obserwacji' '5 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas obserwacji'
GOAL:
  SET NAME 'Kontrola spadku ciśnienia (max 3 bar/10s)'
  SET 'czas pomiaru' '10 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas pomiaru'
  MAX 'spadek ciśnienia' '3 bar'
  VAL 'spadek ciśnienia' 'bar'
  SAVE 'czas pomiaru'
GOAL:
  SET NAME 'Podłącz automat oddechowy'
GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET 'PUMP' 'off'
  SET 'timeout' '5 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'nadciśnienie' '2.2 mbar'
  MAX 'nadciśnienie' '4.1 mbar'
  VAL 'nadciśnienie' 'mbar'
  SAVE 'nadciśnienie'
GOAL:
  SET NAME 'Test sygnału akustycznego'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  MIN 'ciśnienie NC' '0.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
  SAVE 'wynik sygnału'
GOAL:
  SET NAME 'Wytworzenie podciśnienia'
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  SET 'timeout' '20 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'ciśnienie NC' '-12.0 mbar'
  MAX 'ciśnienie NC' '12.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
GOAL:
  SET NAME 'Ustawienie parametru AUTO'
  SET 'PUMP' 'off'
  SET 'zawór BO04' '1'
  SET 'timeout' '15 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MAX 'ciśnienie NC' '-6.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
GOAL:
  SET NAME 'Test szczelności automatu oddechowego'
  SET 'czas stabilizacji' '5 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas stabilizacji'
  MAX 'ciśnienie NC końcowe' '-4.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
  IF 'ciśnienie NC' > '-4.0 mbar'
  SAVE 'ciśnienie NC'

