VERSION: 5
SCENARIO: PSS 7000 z maską FENZY ZENITH

GOAL:
  SET NAME 'Test wizualny'
  LOG 'Inspekcja wizualna aparatu'
  SAVE wynik-wizualny

GOAL:
  SET NAME 'Podłącz złącza SC'
  LOG 'Akcja manualna: podłącz złącza SC'

GOAL:
  SET NAME 'Odkręć zawór butli'
  SET 'zawór-butli-300bar' '1'

GOAL:
  SET NAME 'Załóż maskę'
  LOG 'Akcja manualna: załóż maskę FENZY ZENITH'

GOAL:
  SET NAME 'Test statyczny SC'
  SET 'pump-main' '0'
  SET WAIT '3 s'
  SAVE ciśnienie-sc
  RANGE 'AI02' '6.0 bar' .. '8.0 bar'
  VAL 'AI02' 'bar'
  PASS 'Ciśnienie SC w normie (FENZY ZENITH)'
  FAIL 'Błąd: ciśnienie SC poza zakresem (FENZY ZENITH)'

GOAL:
  SET NAME 'Zmiana SC'
  SET WAIT '6 s'
  SAVE delta-ciśnienia-sc
  RANGE 'AI01' '-1.0 bar' .. '0.5 bar'
  VAL 'AI01' 'bar'
  PASS 'Delta ciśnienia w normie (FENZY ZENITH)'
  FAIL 'Błąd: przekroczona delta ciśnienia (FENZY ZENITH)'

GOAL:
  SET NAME 'Zamknij zawór butli'
  SET 'zawór-butli-300bar' '0'

GOAL:
  SET NAME 'Test szczelności WC'
  SET 'pump-main' '0'
  SET WAIT '5 s'
GOAL:
  SET NAME 'Kontrola spadku WC'
  SET WAIT '10 s'
  SAVE spadek-ciśnienia
  RANGE 'AI01' '0.0 bar' .. '3.0 bar'
  VAL 'AI01' 'bar'
  PASS 'Spadek WC w normie'
  FAIL 'Błąd: spadek WC poza zakresem'

GOAL:
  SET NAME 'Podłącz automat oddechowy'
  LOG 'Akcja manualna: podłącz automat oddechowy'

GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET 'pump-main' '0'
  SET WAIT '5 s'
  SAVE nadciśnienie
  RANGE 'AI01' '2.2 mbar' .. '4.1 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Nadciśnienie statyczne w normie (FENZY ZENITH)'
  FAIL 'Błąd: nadciśnienie poza zakresem (FENZY ZENITH)'

GOAL:
  SET NAME 'Test sygnału akustycznego'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-bo06' '1'
  SET WAIT '2 s'
  SAVE wynik-sygnału
  RANGE 'AI01' '0.0 mbar' .. '1.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Sygnał akustyczny OK'
  FAIL 'Błąd: sygnał akustyczny poza zakresem'

GOAL:
  SET NAME 'Wytworzenie podciśnienia'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-bo06' '1'
  SET WAIT '20 s'
  RANGE 'AI01' '-12.0 mbar' .. '12.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Podciśnienie w normie (FENZY ZENITH)'
  FAIL 'Błąd: podciśnienie poza zakresem (FENZY ZENITH)'

GOAL:
  SET NAME 'Ustawienie auto'
  SET 'pump-main' '0'
  SET 'valve-bo04' '1'
  SET WAIT '15 s'
  RANGE 'AI01' '-12.0 mbar' .. '-6.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Ustawienie auto OK'
  FAIL 'Błąd: ustawienie auto poza zakresem'

GOAL:
  SET NAME 'Test szczelności automatu'
  SET WAIT '5 s'
  SAVE ciśnienie-nc-końcowe
  RANGE 'AI01' '-8.0 mbar' .. '-4.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Szczelność automatu OK'
  FAIL 'Błąd: szczelność automatu poza zakresem'
