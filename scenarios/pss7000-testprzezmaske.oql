VERSION: 5
SCENARIO: PSS 7000 — Test szczelności automatu (przez maskę)
DESCRIPTION: Sekwencyjna wersja testu z płaską strukturą (bez zagnieżdżonego IF).

GOAL:
  SET NAME 'Test statyczny SC'
  SET 'pump-main' '0 l/min'
  SET WAIT '3 s'
  SAVE ciśnienie-sc
  RANGE 'AI02' '6.0 bar' .. '10.0 bar'
  VAL 'AI02' 'bar'
  PASS 'Ciśnienie SC w normie (6-10 bar)'
  FAIL 'Błąd: ciśnienie SC poza zakresem'

GOAL:
  SET NAME 'Delta SC'
  SET WAIT '60 s'
  SAVE delta-ciśnienia-sc
  RANGE 'AI02' '-0.3 bar' .. '0.6 bar'
  VAL 'AI02' 'bar'
  PASS 'Delta ciśnienia SC w normie'
  FAIL 'Błąd: delta ciśnienia SC poza zakresem'

GOAL:
  SET NAME 'Ciśnienie otwarcia automatu'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-nc' '1'
  SET WAIT '8 s'
  SAVE ciśnienie-nc-min
  RANGE 'AI01' '-29.0 mbar' .. '-5.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Ciśnienie otwarcia w normie'
  FAIL 'Błąd: ciśnienie otwarcia poza zakresem'

GOAL:
  SET NAME 'Nadciśnienie statyczne'
  SET 'pump-main' '0 l/min'
  SET WAIT '10 s'
  SAVE nadciśnienie
  RANGE 'AI01' '2.0 mbar' .. '4.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Nadciśnienie statyczne w normie'
  FAIL 'Błąd: nadciśnienie poza zakresem'

GOAL:
  SET NAME 'Sygnał akustyczny'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-nc' '1'
  SET WAIT '2 s'
  RANGE 'AI01' '0.0 mbar' .. '1.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Sygnał akustyczny OK'
  FAIL 'Błąd: sygnał akustyczny poza zakresem'
  SAVE wynik-operatora

GOAL:
  SET NAME 'Wytworzenie podciśnienia'
  SET 'pump-main' '5.0 l/min'
  SET 'valve-nc' '1'
  SET WAIT '20 s'
  RANGE 'AI01' '-15.0 mbar' .. '-10.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Podciśnienie w normie'
  FAIL 'Błąd: podciśnienie poza zakresem'

GOAL:
  SET NAME 'Szczelność automatu'
  SET 'pump-main' '0 l/min'
  SET 'valve-nc' '0'
  SET WAIT '15 s'
  SAVE ciśnienie-nc-końcowe
  RANGE 'AI01' '-12.0 mbar' .. '-6.5 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Szczelność automatu OK'
  FAIL 'Błąd: szczelność automatu poza zakresem'
