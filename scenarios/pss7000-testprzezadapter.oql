VERSION: 4
SCENARIO: PSS 7000 — Test szczelności automatu (przez adapter)

GOAL:
  SET NAME 'Test statyczny SC'
  SET 'pump-main' '0'
  SET WAIT '3 s'
  SAVE ciśnienie-sc
  IF 'AI02' '6.0 .. 10.0 bar'
  CORRECT 'Ciśnienie SC w normie (6-10 bar)'
  ERROR 'Błąd: ciśnienie SC poza zakresem'

GOAL:
  SET NAME 'Delta SC'
  SET 'pump-main' '0'
  SET WAIT '60 s'
  SAVE delta-ciśnienia-sc
  IF 'AI02' '-0.3 .. 0.6 bar'
  CORRECT 'Delta ciśnienia SC w normie'
  ERROR 'Błąd: delta ciśnienia SC poza zakresem'

GOAL:
  SET NAME 'Ciśnienie otwarcia automatu'
  SET 'pump-main' '5 l/min'
  SET 'valve-nc' '1'
  SET WAIT '8 s'
  SAVE ciśnienie-nc-min
  IF 'AI01' '-29.0 .. -5.0 mbar'
  CORRECT 'Ciśnienie otwarcia w normie'
  ERROR 'Błąd: ciśnienie otwarcia poza zakresem'

GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET 'pump-main' '0'
  SET WAIT '10 s'
  SAVE nadciśnienie
  IF 'AI01' '2.0 .. 4.0 mbar'
  CORRECT 'Nadciśnienie statyczne w normie'
  ERROR 'Błąd: nadciśnienie poza zakresem'

GOAL:
  SET NAME 'Sygnał akustyczny'
  SET 'pump-main' '5 l/min'
  SET 'valve-nc' '1'
  SET WAIT '2 s'
  IF 'AI01' '0.0 .. 1.0 mbar'
  CORRECT 'Sygnał akustyczny OK'
  ERROR 'Błąd: sygnał akustyczny poza zakresem'
  SAVE wynik-operatora

GOAL:
  SET NAME 'Wytworzenie podciśnienia'
  SET 'pump-main' '5 l/min'
  SET 'valve-sc' '1'
  SET WAIT '20 s'
  IF 'AI01' '0.0 .. 12.0 mbar'
  CORRECT 'Podciśnienie w normie'
  ERROR 'Błąd: podciśnienie poza zakresem'

GOAL:
  SET NAME 'Szczelność automatu'
  SET 'pump-main' '0'
  SET 'valve-nc' '0'
  SET WAIT '15 s'
  SAVE ciśnienie-nc-końcowe
  IF 'AI01' '6.5 .. 8.0 mbar'
  CORRECT 'Szczelność automatu OK'
  ERROR 'Błąd: szczelność automatu poza zakresem'
