VERSION: 4
SCENARIO: XML Example — Leak Sequence

GOAL:
  SET NAME 'XML Example — Leak Sequence'
TASK: Włącz [zawór BO05]
PUMP [10 l]
WAIT [5 s]
MIN [Ciśnienie otwarcia zaworu] = [4.2 mbar]
MAX [Ciśnienie otwarcia zaworu] = [6.0 mbar]
