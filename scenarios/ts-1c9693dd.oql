VERSION: 4
SCENARIO: XML Example — Leak Sequence

GOAL:
  SET NAME 'XML Example — Leak Sequence'
  LOG 'TASK Włącz zawór BO05'
  SET PUMP 10l
  WAIT 5s
  IF 'Ciśnienie_otwarcia_zaworu' '4.2 .. 6.0 mbar'
  CORRECT 'Ciśnienie_otwarcia_zaworu w zakresie 4.2 .. 6.0 mbar'
  ERROR 'Ciśnienie_otwarcia_zaworu poza zakresem 4.2 .. 6.0 mbar'
  LOG 'VAL Ciśnienie otwarcia zaworu mbar'
  IF Ciśnienie_otwarcia_zaworu 4.2mbar .. 999999
  IF Ciśnienie_otwarcia_zaworu -999999 .. 6.0mbar
  SAVE Ciśnienie otwarcia zaworu
  LOG 'TASK Włącz zawór BO03'
  SET PUMP 0
  WAIT 3s
