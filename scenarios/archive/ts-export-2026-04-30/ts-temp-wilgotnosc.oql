VERSION: 4
# Test temperatury i wilgotności
# Category: env

SCENARIO: Pomiar warunków środowiskowych

FUNC:
  SET NAME 'Pomiar środowiskowy'
  # $1=czujnik  $2=interwał  $3=czas  $4=min  $5=max  $6=unit
  SET '$1' '1'
  SAMPLE $1 START $2
  WAIT $3
  SAMPLE $1 STOP
  GET $1
  SAVE $1
  IF '$1' '$4 .. $5 $6'
  CORRECT 'Pomiar w normie'
  ERROR 'Błąd: pomiar poza zakresem'
  SET '$1' '0'

GOAL:
  SET NAME 'pomiar temp wilgotność'
  FUNC 'Pomiar środowiskowy' 'temperatura' '1s' '10s' '15' '25' '°C'
  FUNC 'Pomiar środowiskowy' 'wilgotność' '1s' '10s' '30' '70' '%RH'
