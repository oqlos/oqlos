VERSION: 4
GOAL:
  SET NAME 'Test spadku ciśnienia automatu'
  LOG 'TASK Ustaw przepływ regulator 50 l/min'
  SET 'pompa_1' '1'
  SAMPLE ciśnienie START 50ms
  SET 'czas_pomiaru' '10s'
  WAIT 10s
  SAMPLE ciśnienie STOP
  LOG 'CALC dp_srednie = AVG ciśnienie'
  IF 'dp_srednie' '0.5 .. 3.5 mbar'
    CORRECT 'dp_srednie w zakresie 0.5 .. 3.5 mbar'
    ERROR 'dp_srednie poza zakresem 0.5 .. 3.5 mbar'
  LOG 'VAL dp_srednie mbar'
  SET 'pompa_1' '0'
