VERSION: 5

SCENARIO: "Mask Leak Test"
DEVICE_TYPE: "pp-mask"
DEVICE_MODEL: "Full face mask"

GOAL:
  SET NAME 'Oględziny wizualne maski'
  LOG 'Sprawdź stan wizualny maski: uszczelki, elementy elastyczne, szyba'
  LOG 'Nałóż maskę na głowę testową i dokładnie uszczelnij'
  SAVE result

GOAL:
  SET NAME 'Test szczelności maski -10 mbar przez 60 sekund'
  SET 'pompa-1' '2.0 l/min'
  SET 'valve-nc' '1'
  SET WAIT '2000 ms'
  RANGE 'AI01' '-11.0 mbar' .. '-9.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Podciśnienie startowe w zakresie -11.0 .. -9.0 mbar'
  FAIL 'Podciśnienie startowe poza zakresem'
  SAVE AI01.value
  SET 'pompa-1' '0 l/min'
  SET WAIT '60 s'
  RANGE 'AI01' '-11.0 mbar' .. '-9.0 mbar'
  PASS 'Maska szczelna po 60 sekundach'
  FAIL 'Maska nieszczelna - delta większa niż 1 mbar'
  SAVE AI01.value

GOAL:
  SET NAME 'Ciśnienie otwarcia zaworu wydechowego'
  SET 'pompa-1' '0.5 l/min'
  SET 'valve-nc' '0'
  SET WAIT '1000 ms'
  RANGE 'AI01' '4.2 mbar' .. '6.0 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Ciśnienie otwarcia zaworu w zakresie 4.2 .. 6.0 mbar'
  FAIL 'Ciśnienie otwarcia poza zakresem'
  SAVE AI01.min

GOAL:
  SET NAME 'Nadciśnienie statyczne'
  SET 'pompa-1' '0.5 l/min'
  SET 'valve-overpressure' '1'
  SET WAIT '3000 ms'
  RANGE 'AI01' '1.0 mbar' .. '3.9 mbar'
  VAL 'AI01' 'mbar'
  PASS 'Nadciśnienie statyczne w zakresie 1.0 .. 3.9 mbar'
  FAIL 'Nadciśnienie statyczne poza zakresem'
  SAVE AI01.value
  SET 'pump-main' '0 l/min'
  SET 'valve-overpressure' '0'
