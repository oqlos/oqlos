SCENARIO: Test Przepływu
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

GOAL przepływ-5-l-min:
  SET pump-main 5.0 l/min
  WAIT 2s
  GET przepływ
  SAVE przepływ-5l

GOAL przepływ-10-l-min:
  SET pump-main 10.0 l/min
  WAIT 2s
  GET przepływ
  SAVE przepływ-10l
  SET pump-main 0 l/min
