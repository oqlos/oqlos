SCENARIO: 'Test Przepływu'
DEVICE_TYPE: 'BA'
DEVICE_MODEL: 'PSS 7000'
MANUFACTURER: 'Dräger'

GOAL: Test przepływu z pompą 5 l/min
  1. Uruchom pompę z przepływem 5 l/min:
    SET 'PUMP' '5 l'
    WAIT 2000
  2. Odczytaj przepływ:
    VAL 'przepływ' 'l/min'
    SAVE: przeplyw_5l

GOAL: Test przepływu z pompą 10 l/min
  1. Zwiększ przepływ do 10 l/min:
    SET 'PUMP' '10 l'
    WAIT 2000
  2. Odczytaj przepływ:
    VAL 'przepływ' 'l/min'
    SAVE: przeplyw_10l
  3. Wyłącz pompę:
    SET 'PUMP' 'off'

