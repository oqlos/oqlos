VERSION: 4
SCENARIO: Test Przepływu
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

FUNC:
  SET NAME 'Pomiar przepływu'
  SET 'pump-main' '$1'
  WAIT 2s
  GET przepływ
  SAVE $2

GOAL:
  SET NAME 'przepływ 5 l min'
  FUNC 'Pomiar przepływu' '5.0 l/min' 'przepływ-5l'

GOAL:
  SET NAME 'przepływ 10 l min'
  FUNC 'Pomiar przepływu' '10.0 l/min' 'przepływ-10l'
  SET 'pump-main' '0 l/min'
