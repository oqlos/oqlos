VERSION: 4
# C202 Example scenario
# Category: other

SCENARIO: Aparat C202 — przykład

FUNC:
  SET NAME 'Sprawdź sensor'
  # $1=sensor  $2=min  $3=max  $4=unit  $5=save-label
  IF '$1' '$2 .. $3 $4'
  CORRECT 'Pomiar w normie'
  ERROR 'Błąd: pomiar poza zakresem'
  SAVE $5

GOAL:
  SET NAME 'kontrola wizualna'
  LOG 'Inspekcja wizualna — potwierdzenie operatora'
  SAVE wynik-wizualny

GOAL:
  SET NAME 'test szczelności'
  FUNC 'Sprawdź sensor' 'AI01' '-10' '0' 'mbar' 'ciśnienie-NC'

GOAL:
  SET NAME 'test szczelności pełny'
  SET 'pump-main' '5 l/min'
  SET 'valve-bo06' '1'
  SET WAIT '20 s'
  FUNC 'Sprawdź sensor' 'AI01' '-10' '0' 'mbar' 'ciśnienie-NC-pełny'
  SET 'pump-main' '0'
  SET 'valve-bo04' '0'
  SET 'valve-bo05' '0'
  SET 'valve-bo06' '0'

GOAL:
  SET NAME 'ciśnienie otwarcia zaw wyd'
  FUNC 'Sprawdź sensor' 'ciśnienie' '11' '12' 'bar' 'ciśnienie-otwarcia'

GOAL:
  SET NAME 'test nadciśnienia'
  SET WAIT '10 s'
  FUNC 'Sprawdź sensor' 'nadciśnienie' '2.0' '3.9' 'mbar' 'nadciśnienie'
