GOAL: Kalibracja punktu zero
  SET 'moduł kalibracyjny' '1'
  SET 'ciśnienie odniesienia' '0 mbar'
  SAMPLE 'czujnik_1' 'START' '500 ms'
  SAMPLE 'czujnik_2' 'START' '500 ms'
  WAIT '5 s'
  VAL 'offset_1' 'mbar'
  VAL 'offset_2' 'mbar'
  FUNC 'korekta_1' = 'SUB' '0,offset_1'
  FUNC 'korekta_2' = 'SUB' '0,offset_2'
  SAVE 'korekta_1' 'kalibracja'
  SAVE 'korekta_2' 'kalibracja'
  SET 'moduł kalibracyjny' '0'
GOAL: Kalibracja punktu odniesienia
  SET 'ciśnienie odniesienia' '100 mbar'
  SET 'pompa kalibracyjna' '1'
  SAMPLE 'czujnik_1' 'START' '500 ms'
  SAMPLE 'czujnik_2' 'START' '500 ms'
  WAIT '5 s'
  VAL 'gain_1' 'mbar'
  VAL 'gain_2' 'mbar'
  FUNC 'wspolczynnik_1' = 'DIV' '100,gain_1'
  FUNC 'wspolczynnik_2' = 'DIV' '100,gain_2'
  SAVE 'wspolczynnik_1' 'kalibracja'
  SAVE 'wspolczynnik_2' 'kalibracja'
  SET 'pompa kalibracyjna' '0'
GOAL: Weryfikacja kalibracji
  SET 'pompa testowa' '1'
  SET 'cisnienie_testowe' '50 mbar'
  WAIT '3 s'
  VAL 'odczyt_1' 'mbar'
  VAL 'odczyt_2' 'mbar'
  MIN 'odczyt_1' '48 mbar'
  MAX 'odczyt_1' '52 mbar'
  MIN 'odczyt_2' '48 mbar'
  MAX 'odczyt_2' '52 mbar'
  SET 'pompa testowa' '0'
  SET 'certyfikat kalibracji' '1'
