VERSION: 4
SCENARIO: Kalibracja czujników ciśnienia

FUNC:
  SET NAME 'Próbkuj czujnik'
  # $1=czujnik  $2=interwał  $3=czas  $4=label
  SAMPLE $1 START $2
  WAIT $3
  SAMPLE $1 STOP
  GET $1
  SAVE $4

GOAL:
  SET NAME 'kalibracja punkt zero'
  SET 'moduł-kalibracyjny' '1'
  SET 'ciśnienie-odniesienia' '0 mbar'
  FUNC 'Próbkuj czujnik' 'czujnik-1' '500ms' '5s' 'offset-1'
  FUNC 'Próbkuj czujnik' 'czujnik-2' '500ms' '5s' 'offset-2'
  SET 'moduł-kalibracyjny' '0'

GOAL:
  SET NAME 'kalibracja punkt odniesienia'
  SET 'ciśnienie-odniesienia' '100 mbar'
  SET 'pompa-kalibracyjna' '1'
  FUNC 'Próbkuj czujnik' 'czujnik-1' '500ms' '5s' 'gain-1'
  FUNC 'Próbkuj czujnik' 'czujnik-2' '500ms' '5s' 'gain-2'
  SET 'pompa-kalibracyjna' '0'

GOAL:
  SET NAME 'weryfikacja kalibracji'
  SET 'pompa-testowa' '1'
  SET WAIT '3 s'
  SAVE odczyt-1
  SAVE odczyt-2
  IF 'czujnik-1' '48 .. 52 mbar'
  CORRECT 'Czujnik 1 kalibracja OK (48-52 mbar)'
  ERROR 'Błąd: czujnik 1 poza zakresem kalibracji'
  IF 'czujnik-2' '48 .. 52 mbar'
  CORRECT 'Czujnik 2 kalibracja OK (48-52 mbar)'
  ERROR 'Błąd: czujnik 2 poza zakresem kalibracji'
  SET 'pompa-testowa' '0'
  SAVE certyfikat-kalibracji
