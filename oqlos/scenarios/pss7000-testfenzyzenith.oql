GOAL: TEST SZCZELNOŚCI AUTOMATU ODDECHOWEGO
  SET 'Operator' 'confirm'
  SAVE 'result'
  SET 'Operator' 'confirm'
  SET 'Operator' 'confirm'
  SET 'Operator' 'confirm'
  SET 'Pump' 'off'
  MIN 'AI02' '6.0 bar'
  IF 'Timer' ≤ '3.0'
  SAVE 'AI02.value'
  MIN 'AI02' '-1.0 bar'
  SAVE 'AI02.delta'
  SET 'Operator' 'confirm'
  SET 'Pump' 'off'
  SAVE 'timer.value'
  SET 'Operator' 'confirm'
  SET 'Operator' 'confirm'
  SET 'Pump' 'off'
  MIN 'AI01' '2.2 mbar'
  IF 'Timer' ≤ '5.0'
  SAVE 'AI01.value'
  SET 'Pump' 'set'
  SET 'Valve' 'BO06'
  IF 'AI01' ≥ '0.0'
  SET 'Operator' 'confirm'
  SAVE 'operator.result'
  SET 'Pump' 'set'
  SET 'Valve' 'BO06'
  MIN 'AI01' '-12.0 mbar'
  IF 'Timer' ≤ '20.0'
  SET 'Pump' 'off'
  SET 'Valve' 'BO04'
  IF 'AI01' ≤ '-6.0'
  IF 'Timer' ≤ '15.0'
  IF 'AI01' ≤ '-4.0'
  SAVE 'AI01.value'
