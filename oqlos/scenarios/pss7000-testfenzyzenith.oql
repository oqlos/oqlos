GOAL: TEST SZCZELNOŚCI AUTOMATU ODDECHOWEGO
  SET 'pompa 1' '0'
  SAVE 'result'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  MIN 'AI02' '6.0 bar'
  IF 'Timer' ≤ '3.0'
  SAVE 'AI02'
  MIN 'AI02' '-1.0 bar'
  SAVE 'AI02.delta'
  SET 'pompa 1' '0'
  SAVE 'timer'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  MIN 'AI01' '2.2 mbar'
  IF 'Timer' ≤ '5.0'
  SAVE 'AI01'
  SET 'pompa 1' '5 l/min'
  SET 'valve-nc' 'open'
  IF 'AI01' ≥ '0.0'
  SET 'pompa 1' '0'
  SAVE 'operator.result'
  SET 'pompa 1' '5 l/min'
  SET 'valve-nc' 'open'
  MIN 'AI01' '-12.0 mbar'
  IF 'Timer' ≤ '20.0'
  SET 'pompa 1' '0'
  SET 'valve-nc' 'closed'
  IF 'AI01' ≤ '-6.0'
  IF 'Timer' ≤ '15.0'
  IF 'AI01' ≤ '-4.0'
  SAVE 'AI01'
