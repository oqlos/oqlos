SCENARIO: Test wytrzymałości mechanicznej
DESCRIPTION: Pojedynczy cykl obciążenia/odciążenia — pętla cykli jest sterowana z zewnątrz.

CONFIG przygotowanie:
  SET próbka 1
  SET czujnik-siły 1
  SET czujnik-przemieszczenia 1

GOAL cykl-pojedynczy:
  SET siłownik 1
  SET pozycja-docelowa 50 mm
  WAIT 1s
  GET siła-aktualna
  SAVE siła-aktualna
  GET pozycja-aktualna
  SAVE pozycja-aktualna
  CHECK 0 <= siła-aktualna <= 1100 N
  CORRECT 'Siła w zakresie wytrzymałości (0-1100 N)'
  ERROR 'Błąd: siła poza zakresem wytrzymałości'
  SET pozycja-docelowa 0 mm
  WAIT 1s

GOAL ocena-wyniku:
  GET cykle-wykonane
  MIN cykle-wykonane 100 szt
  SET siłownik 0
  SAVE raport-wytrzymałości
