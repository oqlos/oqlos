SCENARIO: PSS 7000 — Test szczelności automatu (przez maskę)
DESCRIPTION: Sekwencyjna wersja testu z płaską strukturą (bez zagnieżdżonego IF).

GOAL test-statyczny-sc:
  SET pump-main 0 l/min
  WAIT 3s
  GET AI02
  SAVE ciśnienie-sc
  MIN AI02 6.0 bar

GOAL delta-sc:
  WAIT 60s
  GET AI02
  SAVE delta-ciśnienia-sc
  MIN AI02 -0.3 bar

GOAL ciśnienie-otwarcia-automatu:
  SET pump-main 5.0 l/min
  SET valve-nc 1
  WAIT 8s
  GET AI01
  SAVE ciśnienie-nc-min
  MIN AI01 -29.0 mbar

GOAL nadciśnienie-statyczne:
  SET pump-main 0 l/min
  WAIT 10s
  GET AI01
  SAVE nadciśnienie
  MIN AI01 2.0 mbar

GOAL sygnał-akustyczny:
  SET pump-main 5.0 l/min
  SET valve-nc 1
  WAIT 2s
  GET AI01
  MIN AI01 0.0 mbar
  SAVE wynik-operatora

GOAL wytworzenie-podciśnienia:
  SET pump-main 5.0 l/min
  SET valve-nc 1
  WAIT 20s
  GET AI01
  MIN AI01 -10.0 mbar

GOAL szczelność-automatu:
  SET pump-main 0 l/min
  SET valve-nc 0
  WAIT 15s
  GET AI01
  SAVE ciśnienie-nc-końcowe
  MAX AI01 -6.5 mbar
