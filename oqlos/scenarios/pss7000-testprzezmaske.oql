GOAL: TEST SZCZELNOŚCI AUTOMATU ODDECHOWEGO
  SET 'pompa 1' '0 l/min'
  SAVE 'result'
  
  MIN 'AI02' '6.0 bar'
  IF 'Timer' ≤ '3.0'
    SAVE 'AI02.value'
    SET 'pompa 1' '0 l/min'
    MIN 'AI02' '-0.3 bar'
    SAVE 'AI02.delta'
    SET 'pompa 1' '5.0 l/min'
    SET 'valve-nc' '1'
    MIN 'AI01' '-29.0 mbar'
    
    IF 'Timer' ≤ '8.0'
      SAVE 'AI01.min'
      SET 'pompa 1' '0 l/min'
      MIN 'AI01' '2.0 mbar'
      
      IF 'Timer' ≤ '10.0'
        SAVE 'AI01.value'
        SET 'pompa 1' '0 l/min'
        SAVE 'timer.value'
        SET 'pompa 1' '5.0 l/min'
        SET 'valve-nc' '1'
        
        IF 'AI01' ≥ '0.0 mbar'
          SET 'pompa 1' '0 l/min'
          SAVE 'operator.result'
          SET 'pompa 1' '5.0 l/min'
          SET 'valve-nc' '1'
          MIN 'AI01' '-10.0 mbar'
          
          IF 'Timer' ≤ '20.0'
            SET 'pompa 1' '0 l/min'
            SET 'valve-nc' '0 (closed)'
            
            IF 'AI01' ≤ '-7.5 mbar'
              IF 'Timer' ≤ '15.0'
                IF 'AI01' ≤ '-6.5 mbar'
                  SAVE 'AI01.value'
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
