# Test temperatury i wilgotności
# Category: env

SCENARIO: Pomiar warunków środowiskowych

GOAL pomiar-temp-wilgotność:
  SET czujnik-temperatury 1
  SET czujnik-wilgotności 1
  SAMPLE temperatura START 1s
  SAMPLE wilgotność START 1s
  WAIT 10s
  SAMPLE temperatura STOP
  SAMPLE wilgotność STOP
  GET temperatura
  SAVE temperatura
  GET wilgotność
  SAVE wilgotność
  CHECK 15 <= temperatura <= 25 °C
  CORRECT 'Temperatura w normie (15-25°C)'
  ERROR 'Błąd: temperatura poza zakresem 15-25°C'
  CHECK 30 <= wilgotność <= 70 %RH
  CORRECT 'Wilgotność w normie (30-70%RH)'
  ERROR 'Błąd: wilgotność poza zakresem 30-70%RH'
  SET czujnik-temperatury 0
  SET czujnik-wilgotności 0
