# Test temperatury i wilgotności
# Category: env

GOAL: Pomiar warunków środowiskowych
  SET 'czujnik temperatury' '1'
  SET 'czujnik wilgotności' '1'
  SAMPLE 'temperatura' 'START' '1000 ms'
  SAMPLE 'wilgotnosc' 'START' '1000 ms'
  WAIT '10 s'
  VAL 'temperatura' '°C'
  VAL 'wilgotnosc' '%RH'
  SAMPLE 'temperatura' 'STOP'
  SAMPLE 'wilgotnosc' 'STOP'
  MIN 'temperatura' '15 °C'
  MAX 'temperatura' '25 °C'
  MIN 'wilgotnosc' '30 %RH'
  MAX 'wilgotnosc' '70 %RH'
  IF 'temperatura' < '15'
  ELSE ERROR 'Temperatura poniżej dopuszczalnego minimum'
  IF 'temperatura' > '25'
  ELSE ERROR 'Temperatura powyżej dopuszczalnego maksimum'
  IF 'wilgotnosc' < '30'
  ELSE ERROR 'Wilgotność poniżej dopuszczalnego minimum'
  IF 'wilgotnosc' > '70'
  ELSE ERROR 'Wilgotność powyżej dopuszczalnego maksimum'
  SET 'czujnik temperatury' '0'
  SET 'czujnik wilgotności' '0'
