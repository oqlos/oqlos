VERSION: 4
SCENARIO: Test Zaworu
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

# Oczekiwane okna napięciowe (kalibracja piADC):
#   AI01 (NC): 0.60 – 0.67 V
#   AI02 (SC): 0.73 – 0.78 V
#   AI03 (WC): 0.86 – 0.91 V

FUNC:
  SET NAME 'Test zaworu'
  # $1=zawór  $2=stan  $3=czujnik  $4=min  $5=max  $6=label
  SET '$1' '$2'
  WAIT 500ms
  IF '$3' '$4 .. $5 V'
  CORRECT 'Napięcie w zakresie kalibracji'
  ERROR 'Błąd: napięcie poza zakresem'
  SAVE $6

GOAL:
  SET NAME 'test odczytu nc otwarty'
  FUNC 'Test zaworu' 'valve-nc' '1' 'AI01' '0.60' '0.67' 'cisnienie-nc-otwarte'

GOAL:
  SET NAME 'test odczytu nc zamkniety'
  FUNC 'Test zaworu' 'valve-nc' '0' 'AI01' '0.60' '0.67' 'cisnienie-nc-zamkniete'

GOAL:
  SET NAME 'test odczytu sc otwarty'
  FUNC 'Test zaworu' 'valve-sc' '1' 'AI02' '0.73' '0.78' 'cisnienie-sc-otwarte'

GOAL:
  SET NAME 'test odczytu sc zamkniety'
  FUNC 'Test zaworu' 'valve-sc' '0' 'AI02' '0.73' '0.78' 'cisnienie-sc-zamkniete'

GOAL:
  SET NAME 'test stabilności wc'
  FUNC 'Test zaworu' 'valve-wc' '1' 'AI03' '0.86' '0.91' 'cisnienie-wc-poczatek'
  FUNC 'Test zaworu' 'valve-wc' '0' 'AI03' '0.86' '0.91' 'cisnienie-wc-koniec'
