SCENARIO: 'Test Zaworu'
DEVICE_TYPE: 'BA'
DEVICE_MODEL: 'PSS 7000'
MANUFACTURER: 'Dräger'

GOAL: Test odczytu zaworu NC
  # Otwórz zawór NC
  SET 'zawór NC' '1'
  WAIT '500 ms'
  
  VAL 'AI01' 'V'
  IF 'AI01' < '0.60'
    ELSE ERROR 'Zawór NC nie mieści się w oczekiwanym zakresie (za niski)'
  ENDIF
  IF 'AI01' > '0.67'
    ELSE ERROR 'Zawór NC nie mieści się w oczekiwanym zakresie (za wysoki)'
  ENDIF
  SAVE 'cisnienie_nc_otwarte'

GOAL: Test odczytu zaworu NC po zamknięciu
  # Zamknij zawór NC
  SET 'zawór NC' '0'
  WAIT '500 ms'
  
  VAL 'AI01' 'V'
  IF 'AI01' < '0.60'
    ELSE ERROR 'Zawór NC po zamknięciu nie mieści się w oczekiwanym zakresie'
  ENDIF
  IF 'AI01' > '0.67'
    ELSE ERROR 'Zawór NC po zamknięciu nie mieści się w oczekiwanym zakresie'
  ENDIF
  SAVE 'cisnienie_nc_zamkniete'

GOAL: Test odczytu zaworu SC
  # Otwórz zawór SC
  SET 'zawór SC' '1'
  WAIT '500 ms'

  VAL 'AI02' 'V'
  IF 'AI02' < '0.73'
    ELSE ERROR 'Zawór SC nie mieści się w oczekiwanym zakresie'
  ENDIF
  IF 'AI02' > '0.78'
    ELSE ERROR 'Zawór SC nie mieści się w oczekiwanym zakresie'
  ENDIF
  SAVE 'cisnienie_sc_otwarte'

GOAL: Test odczytu zaworu SC po zamknięciu
  # Zamknij zawór SC
  SET 'zawór SC' '0'
  WAIT '500 ms'

  VAL 'AI02' 'V'
  IF 'AI02' < '0.73'
    ELSE ERROR 'Zawór SC po zamknięciu nie mieści się w oczekiwanym zakresie'
  ENDIF
  IF 'AI02' > '0.78'
    ELSE ERROR 'Zawór SC po zamknięciu nie mieści się w oczekiwanym zakresie'
  ENDIF
  SAVE 'cisnienie_sc_zamkniete'

GOAL: Test stabilności zaworu WC
  # Otwórz zawór WC
  SET 'zawór WC' '1'
  WAIT '1000 ms'
  
  VAL 'AI03' 'V'
  IF 'AI03' < '0.86'
    ELSE ERROR 'Zawór WC nie mieści się w oczekiwanym zakresie'
  ENDIF
  IF 'AI03' > '0.91'
    ELSE ERROR 'Zawór WC nie mieści się w oczekiwanym zakresie'
  ENDIF
  SAVE 'cisnienie_wc_poczatek'
  
  # Zamknij i obserwuj
  SET 'zawór WC' '0'
  WAIT '3000 ms'
  
  VAL 'AI03' 'V'
  IF 'AI03' < '0.86'
    ELSE ERROR 'Zawór WC po zamknięciu nie mieści się w oczekiwanym zakresie'
  ENDIF
  IF 'AI03' > '0.91'
    ELSE ERROR 'Zawór WC po zamknięciu nie mieści się w oczekiwanym zakresie'
  ENDIF
  SAVE 'cisnienie_wc_koniec'
