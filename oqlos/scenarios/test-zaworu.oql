SCENARIO: Test Zaworu
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

# Oczekiwane okna napięciowe (kalibracja piADC):
#   AI01 (NC): 0.60 – 0.67 V
#   AI02 (SC): 0.73 – 0.78 V
#   AI03 (WC): 0.86 – 0.91 V

GOAL test-odczytu-nc-otwarty:
  SET valve-nc 1
  WAIT 500ms
  CHECK 0.60 <= AI01 <= 0.67 V
  CORRECT 'Napięcie NC w zakresie kalibracji (otwarty)'
  ERROR 'Błąd: napięcie NC poza zakresem 0.60-0.67 V (zawór otwarty)'
  SAVE cisnienie-nc-otwarte

GOAL test-odczytu-nc-zamkniety:
  SET valve-nc 0
  WAIT 500ms
  CHECK 0.60 <= AI01 <= 0.67 V
  CORRECT 'Napięcie NC w zakresie kalibracji (zamknięty)'
  ERROR 'Błąd: napięcie NC poza zakresem 0.60-0.67 V (zawór zamknięty)'
  SAVE cisnienie-nc-zamkniete

GOAL test-odczytu-sc-otwarty:
  SET valve-sc 1
  WAIT 500ms
  CHECK 0.73 <= AI02 <= 0.78 V
  CORRECT 'Napięcie SC w zakresie kalibracji (otwarty)'
  ERROR 'Błąd: napięcie SC poza zakresem 0.73-0.78 V (zawór otwarty)'
  SAVE cisnienie-sc-otwarte

GOAL test-odczytu-sc-zamkniety:
  SET valve-sc 0
  WAIT 500ms
  CHECK 0.73 <= AI02 <= 0.78 V
  CORRECT 'Napięcie SC w zakresie kalibracji (zamknięty)'
  ERROR 'Błąd: napięcie SC poza zakresem 0.73-0.78 V (zawór zamknięty)'
  SAVE cisnienie-sc-zamkniete

GOAL test-stabilności-wc:
  SET valve-wc 1
  WAIT 1s
  CHECK 0.86 <= AI03 <= 0.91 V
  CORRECT 'Napięcie WC w zakresie kalibracji (początek)'
  ERROR 'Błąd: napięcie WC poza zakresem 0.86-0.91 V'
  SAVE cisnienie-wc-poczatek
  SET valve-wc 0
  WAIT 3s
  CHECK 0.86 <= AI03 <= 0.91 V
  CORRECT 'Napięcie WC w zakresie kalibracji (stabilność)'
  ERROR 'Błąd: napięcie WC poza zakresem 0.86-0.91 V (brak stabilności)'
  SAVE cisnienie-wc-koniec
