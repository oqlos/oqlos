VERSION: 4
# lib/hardware.oql — biblioteka makr dla sprawdzeń sprzętowych.
#
# Makra są używane w scenariuszach przez komendę CALL, np.
#
#   INCLUDE "lib/hardware.oql"
#   GOAL diagnostyka:
#     CALL hw-pump-smoke
#     CALL hw-valves-reset
#
# Podstawianie argumentów: używamy $1, $2, ... w ciele makra
# (wynik stringowego replace po tokenizacji linii).

SCENARIO: lib/hardware — makra sprzętowe
CATEGORY: library

MACRO hw-pump-smoke:
  # krótki impuls pompy głównej: 2 s przy 5 l/min, potem zero.
  LOG 'hw-pump-smoke: start'
  SET pump-main 5 l/min
  WAIT 2s
  SET pump-main 0
  LOG 'hw-pump-smoke: koniec'

MACRO hw-pump-off:
  SET pump-main 0
  SET pompa-1 0

MACRO hw-valves-reset:
  # zamyka wszystkie zawory NC/SC/WC do znanego stanu.
  SET valve-nc 0
  SET valve-sc 0
  SET valve-wc 0
  WAIT 300ms

MACRO hw-valves-smoke:
  # cykl otwierania/zamykania trzech zaworów z krótkimi przerwami.
  SET valve-nc 1
  WAIT 200ms
  SET valve-nc 0
  SET valve-sc 1
  WAIT 200ms
  SET valve-sc 0
  SET valve-wc 1
  WAIT 200ms
  SET valve-wc 0

MACRO hw-lung-smoke:
  SET lung-main 1
  WAIT 1s
  SET lung-main 0

MACRO hw-sensors-baseline:
  # odczyt trzech kanałów pomiarowych i zapis jako baseline.
  GET AI01
  SAVE baseline-nc
  GET AI02
  SAVE baseline-sc
  GET AI03
  SAVE baseline-wc
