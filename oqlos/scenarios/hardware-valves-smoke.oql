VERSION: 4
SCENARIO: Hardware Valves Smoke Test
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

FUNC:
  SET NAME 'Cykl zaworu'
  SET '$1' '1'
  SET WAIT '200 ms'
  SET '$1' '0'

GOAL:
  SET NAME 'smoke test modbus valves'
  LOG 'Cykl NC -> SC -> WC'
  FUNC 'Cykl zaworu' 'valve-nc'
  SET WAIT '200 ms'
  FUNC 'Cykl zaworu' 'valve-sc'
  SET WAIT '200 ms'
  FUNC 'Cykl zaworu' 'valve-wc'
