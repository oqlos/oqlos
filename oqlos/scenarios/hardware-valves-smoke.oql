SCENARIO: 'Hardware Valves Smoke Test'
DEVICE_TYPE: 'BA'
DEVICE_MODEL: 'PSS 7000'
MANUFACTURER: 'Dräger'

GOAL: Test zaworów modbus
  # Otwórz i zamknij zawór NC
  SET 'zawór NC' '1'
  WAIT '200 ms'
  SET 'zawór NC' '0'
  WAIT '200 ms'
  
  # Otwórz i zamknij zawór SC
  SET 'zawór SC' '1'
  WAIT '200 ms'
  SET 'zawór SC' '0'
  WAIT '200 ms'
  
  # Otwórz i zamknij zawór WC
  SET 'zawór WC' '1'
  WAIT '200 ms'
  SET 'zawór WC' '0'
