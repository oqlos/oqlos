SCENARIO: Hardware Valves Smoke Test
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

GOAL smoke-test-modbus-valves:
  LOG "Cykl NC -> SC -> WC"
  SET valve-nc 1
  WAIT 200ms
  SET valve-nc 0
  WAIT 200ms
  SET valve-sc 1
  WAIT 200ms
  SET valve-sc 0
  WAIT 200ms
  SET valve-wc 1
  WAIT 200ms
  SET valve-wc 0
