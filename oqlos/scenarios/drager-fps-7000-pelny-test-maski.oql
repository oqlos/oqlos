GOAL: TEST WIZUALNY
  SET 'pompa 1' '0'
  SET 'Test wizualny' '1'
  SAVE 'Test wizualny'
  SET 'valve-sc' 'open'
  SET 'pompa 1' '5 l/min'
  SET 'WAIT' '7.0 s'
  SET 'valve-nc' 'open'
  SET 'pompa 1' '5 l/min'
  MIN 'AI01' '-11.0 mbar'
  VAL 'AI01' 'mbar'
  IF 'AI01' < '-11.0 mbar' ELSE ERROR 'Wytworzenie  podciśnienia [mbar]'
  SET 'WAIT' '10.0 s'
  SET 'pompa 1' '0'
  SET 'WAIT' '10.0 s'
  SET 'valve-nc' 'closed'
  SET 'pompa 1' '0'
  MAX 'AI01' '-10.1 mbar'
  VAL 'AI01' 'mbar'
  IF 'AI01' > '-10.1 mbar' ELSE ERROR 'Ustawienie parametru Auto [s]'
  SET 'WAIT' '20.0 s'
GOAL: TEST SZCZELNOŚCI MASKI NADCIŚNIENIOWEJ
  SET 'pompa 1' '0'
  MAX 'AI01' '-9.0 mbar'
  VAL 'AI01' 'mbar'
  IF 'AI01' > '-9.0 mbar' ELSE ERROR 'Test szczelności maski'
  SAVE 'AI01'
  SET 'WAIT' '60.0 s'
  SET 'valve-sc' 'open'
  SET 'pompa 1' '10 l/min'
  SET 'WAIT' '5.0 s'
  SET 'valve-sc' 'open'
  SET 'pompa 1' '10 l/min'
  MIN 'AI01' '4.2 mbar'
  MAX 'AI01' '6.0 mbar'
  VAL 'AI01' 'mbar'
  IF 'AI01' < '4.2 mbar' ELSE ERROR 'Ciśnienie otwarcia zaworu wydechowego'
  SAVE 'AI01'
  SET 'WAIT' '1.0 s'
  SET 'valve-nc' 'open'
  SET 'pompa 1' '5 l/min'
  SET 'WAIT' '7.0 s'
