SCENARIO: Dräger FPS 7000 — Pełny test maski

GOAL test-wizualny:
  LOG "Inspekcja wizualna aparatu"
  SET pump-main 0
  SAVE test-wizualny

GOAL wytworzenie-podciśnienia:
  SET valve-sc 1
  SET pump-main 5 l/min
  WAIT 7s
  SET valve-nc 1
  SET pump-main 5 l/min
  WAIT 5s
  GET AI01
  MIN AI01 -11.0 mbar
  SAVE podciśnienie

GOAL ustawienie-auto:
  SET pump-main 0
  WAIT 20s
  SET valve-nc 0
  GET AI01
  MAX AI01 -10.1 mbar
  SAVE auto-start

GOAL szczelność-nadciśnieniowa:
  SET pump-main 0
  WAIT 60s
  GET AI01
  MAX AI01 -9.0 mbar
  SAVE szczelność-maska

GOAL ciśnienie-otwarcia-zaworu-wyd:
  SET valve-sc 1
  SET pump-main 10 l/min
  WAIT 5s
  GET AI01
  CHECK 4.2 <= AI01 <= 6.0 mbar
  CORRECT 'Ciśnienie otwarcia zaworu wydechowego OK (4.2-6.0 mbar)'
  ERROR 'Błąd: ciśnienie otwarcia zaworu wydechowego poza zakresem'
  SAVE ciśnienie-otwarcia-wyd

GOAL wyjście:
  SET valve-nc 1
  SET pump-main 5 l/min
  WAIT 7s
  SET pump-main 0
