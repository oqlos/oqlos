VERSION 3
SCENARIO: Dräger FPS 7000 — Pełny test maski

GOAL:
  SET NAME 'Test wizualny'
  LOG 'Inspekcja wizualna aparatu'
  SET 'pump-main' '0'
  SAVE test-wizualny

GOAL:
  SET NAME 'Wytworzenie podciśnienia'
  SET 'valve-sc' '1'
  SET 'pump-main' '5 l/min'
  WAIT 7s
  SET 'valve-nc' '1'
  SET 'pump-main' '5 l/min'
  WAIT 5s
  IF 'AI01' '-15.0 .. -11.0 mbar'
  CORRECT 'Podciśnienie w normie'
  ERROR 'Błąd: podciśnienie poza zakresem'
  SAVE podciśnienie

GOAL:
  SET NAME 'Ustawienie auto'
  SET 'pump-main' '0'
  WAIT 20s
  SET 'valve-nc' '0'
  GET AI01
  IF 'AI01' '-15.0 .. -10.1 mbar'
  CORRECT 'Ustawienie auto OK'
  ERROR 'Błąd: ustawienie auto poza zakresem'
  SAVE auto-start

GOAL:
  SET NAME 'Szczelność nadciśnieniowa'
  SET 'pump-main' '0'
  WAIT 60s
  IF 'AI01' '-12.0 .. -9.0 mbar'
  CORRECT 'Szczelność nadciśnieniowa OK'
  ERROR 'Błąd: szczelność nadciśnieniowa poza zakresem'
  SAVE szczelność-maska

GOAL:
  SET NAME 'Ciśnienie otwarcia zaworu wydechowego'
  SET 'valve-sc' '1'
  SET 'pump-main' '10 l/min'
  WAIT 5s
  IF 'AI01' '4.2 .. 6.0 mbar'
  CORRECT 'Ciśnienie otwarcia zaworu wydechowego OK (4.2-6.0 mbar)'
  ERROR 'Błąd: ciśnienie otwarcia zaworu wydechowego poza zakresem'
  SAVE ciśnienie-otwarcia-wyd

GOAL:
  SET NAME 'Wyjście'
  SET 'valve-nc' '1'
  SET 'pump-main' '5 l/min'
  WAIT 7s
  SET 'pump-main' '0'
