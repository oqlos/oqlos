VERSION: 4
SCENARIO: Test Pompy
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

FUNC:
  SET NAME 'Pompuj'
  SET 'pompa-1' '$1'
  WAIT $2

GOAL:
  SET NAME 'test przepływu'
  LOG 'Faza 1: pompowanie'
  FUNC 'Pompuj' '2.0 l/min' '2s'
  LOG 'Faza 2: kierunek przeciwny'
  FUNC 'Pompuj' '-2.0 l/min' '2s'
  LOG 'Faza 3: stop'
  SET 'pompa-1' '0 l/min'
