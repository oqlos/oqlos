SCENARIO: 'Test Pompy'
DEVICE_TYPE: 'BA'
DEVICE_MODEL: 'PSS 7000'
MANUFACTURER: 'Dräger'

GOAL: Test przepływu
  # 1. Uruchom pompę 1 ze spacją
  SET 'pompa 1' '2.0 l/min'
  WAIT '2000 ms'
  
  # 2. Zmień kierunek / wartość
  SET 'pompa 1' '-2.0 l/min'
  WAIT '2000 ms'
  
  # 3. Wyłącz pompę
  SET 'pompa 1' '0 l/min'