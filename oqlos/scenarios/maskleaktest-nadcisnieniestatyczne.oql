GOAL:
  SET NAME 'nadciśnienie statyczne maska'
  # oczekiwany zakres: 1.0 – 3.9 mbar
  SET pompa-1 5.0 l/min
  SET valve-nc 1
  WAIT 3s
  IF AI01 1.0 .. 3.9 mbar
  CORRECT 'Nadciśnienie statyczne maski OK (1.0-3.9 mbar)'
  ERROR 'Błąd: nadciśnienie statyczne poza zakresem'
  SAVE nadciśnienie-statyczne
