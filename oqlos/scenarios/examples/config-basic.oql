SCENARIO: 'Basic Init'
DEVICE_TYPE: 'BA'

# ============================================
# CONFIG - Inicjalizacja bezpieczeństwa
# ============================================
CONFIG: Reset zaworów
  # Wszystkie zawory na pozycję zamkniętą
  SET 'valve-nc' 'closed'
  SET 'valve-sc' 'closed'
  SET 'valve-wc' 'closed'
  WAIT 200ms

CONFIG: Wyłączenie pompy
  # Upewnij się że pompa jest wyłączona
  SET 'pump-main' '0'
  SET 'pompa 1' '0'
  SET 'PUMP' 'off'
  WAIT 500
  SAVE: init_complete

# ============================================
# GOAL - Właściwy test
# ============================================
GOAL: Test pompy - cykl pracy
  # Uruchom pompę
  SET 'pompa 1' '3 l/min'
  WAIT 2000ms
  
  # Zmień kierunek
  SET 'pompa 1' '-3 l/min'
  WAIT 2000ms
  
  # Wyłącz
  SET 'pompa 1' '0'
  SAVE: test_pompy_ok
