VERSION 3
SCENARIO: Kalibracja PSS7000
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

# ──────────────────────────────────────────────
# Faza 1: otwarcie zaworów
# ──────────────────────────────────────────────
CONFIG otwarcie-zaworów:
  SET 'valve-nc' '1'
  SET 'valve-sc' '1'
  SET 'valve-wc' '1'
  WAIT 2s

# ──────────────────────────────────────────────
# Faza 2: pomiar bazowy (zero)
# ──────────────────────────────────────────────
CONFIG pomiar-bazowy:
  GET AI01
  SAVE baseline-nc
  GET AI02
  SAVE baseline-sc
  GET AI03
  SAVE baseline-wc
  WAIT 500ms

# ──────────────────────────────────────────────
# Faza 3: zamknięcie zaworów
# ──────────────────────────────────────────────
CONFIG zamknięcie-zaworów:
  SET 'valve-nc' '0'
  SET 'valve-sc' '0'
  SET 'valve-wc' '0'
  WAIT 1s
  SAVE kalibracja-zakończona

# ──────────────────────────────────────────────
# Weryfikacja szczelności NC
# ──────────────────────────────────────────────
GOAL:
  SET NAME 'weryfikacja nc'
  WAIT 5s
  GET AI01
  SAVE ciśnienie-końcowe-nc
