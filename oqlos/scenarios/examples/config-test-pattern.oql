SCENARIO: Test Pattern — Prepare / Test / Cleanup
DEVICE_TYPE: BA

# ──────────────────────────────────────────────
# 1. PREPARE — przygotowanie środowiska
# ──────────────────────────────────────────────
CONFIG prepare-environment:
  SET pump-main 0
  SET pompa-1 0
  SET valve-nc 0
  SET valve-sc 1
  SET valve-wc 0
  WAIT 1s
  SAVE env-prepared

# ──────────────────────────────────────────────
# 2. TEST — właściwy pomiar ciśnienia
# ──────────────────────────────────────────────
GOAL:
  SET NAME 'execute pressure test'
  SET valve-nc 1
  WAIT 500ms
  SET pompa-1 5 l/min
  WAIT 3s
  GET AI02
  SAVE test-result
  SET pompa-1 0
  WAIT 500ms

# ──────────────────────────────────────────────
# 3. CLEANUP — sprzątanie i reset
# ──────────────────────────────────────────────
CONFIG cleanup:
  SET pompa-1 0
  SET pump-main 0
  SET valve-nc 0
  SET valve-sc 0
  SET valve-wc 0
  WAIT 500ms
  SAVE cleanup-done
  SAVE test-sequence-complete
