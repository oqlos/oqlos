VERSION: 4
SCENARIO: Test Pattern — Prepare / Test / Cleanup
DEVICE_TYPE: BA

# ──────────────────────────────────────────────
# 1. PREPARE — przygotowanie środowiska
# ──────────────────────────────────────────────
CONFIG prepare-environment:
  SET 'pump-main' '0'
  SET 'pompa-1' '0'
  SET 'valve-nc' '0'
  SET 'valve-sc' '1'
  SET 'valve-wc' '0'
  SET WAIT '1 s'
  SAVE env-prepared

# ──────────────────────────────────────────────
# 2. TEST — właściwy pomiar ciśnienia
# ──────────────────────────────────────────────
GOAL:
  SET NAME 'execute pressure test'
  SET 'valve-nc' '1'
  SET WAIT '500 ms'
  SET 'pompa-1' '5 l/min'
  SET WAIT '3 s'
  GET AI02
  SAVE test-result
  SET 'pompa-1' '0'
  SET WAIT '500 ms'
# ──────────────────────────────────────────────
# 3. CLEANUP — sprzątanie i reset
# ──────────────────────────────────────────────
CONFIG cleanup:
  SET 'pompa-1' '0'
  SET 'pump-main' '0'
  SET 'valve-nc' '0'
  SET 'valve-sc' '0'
  SET 'valve-wc' '0'
  SET WAIT '500 ms'
  SAVE cleanup-done
  SAVE test-sequence-complete
