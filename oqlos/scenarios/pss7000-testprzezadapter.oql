GOAL: TEST SZCZELNOŚCI AUTOMATU ODDECHOWEGO
  SET 'pompa 1' '0'
  SAVE 'result'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  MIN 'AI02' '6.0 bar'
  IF 'Timer' ≤ '3.0'
  SAVE 'AI02.value'
  SET 'pompa 1' '0'
  MIN 'AI02' '-0.3 bar'
  SAVE 'AI02.delta'
  SET 'pompa 1' '5 l/min'
  SET 'valve-nc' 'open'
  MIN 'AI01' '-29.0 mbar'
  IF 'Timer' ≤ '8.0'
  SAVE 'AI01.min'
  SET 'pompa 1' '0'
  MIN 'AI01' '2.0 mbar'
  IF 'Timer' ≤ '10.0'
  SAVE 'AI01.value'
  SET 'pompa 1' '0'
  SET 'pompa 1' '0'
  SAVE 'operator.result'
  IF 'AI02' ≤ '10.0'
  SAVE 'timer.value'
  SET 'pompa 1' '5 l/min'
  SET 'valve-nc' 'open'
  IF 'AI01' ≥ '0.0'
  SET 'pompa 1' '0'
  SAVE 'operator.result'
  SET 'pompa 1' '5 l/min'
  SET 'valve-sc' 'open'
  IF 'AI01' ≤ '12.0'
  IF 'Timer' ≤ '20.0'
  SET 'pompa 1' '0'
  SET 'valve-nc' 'closed'
  IF 'AI01' ≥ '7.5'
  IF 'Timer' ≤ '15.0'
  IF 'AI01' ≥ '6.5'
  SAVE 'AI01.value'
