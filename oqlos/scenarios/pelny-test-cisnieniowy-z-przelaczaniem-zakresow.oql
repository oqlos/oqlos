GOAL: Przygotowanie testu ciśnieniowego
  SET 'pompa próżniowa' '1'
  SET 'pompa ciśnieniowa' '1'
  SET 'czujnik próżni' '1'
  SET 'czujnik niskiego ciśnienia' '1'
  SET 'czujnik wysokiego ciśnienia' '1'
  SET 'zakres_prozni' '-1000..0 mbar'
  SET 'zakres_niski' '0..50 mbar'
  SET 'zakres_wysoki' '50..2000 mbar'
  SET 'zawór izolacyjny' '1'
GOAL: Test próżni
  SET 'pompa próżniowa' '1'
  SAMPLE 'ciśnienie' 'START' '50 ms'
  SET 'target_proznia' '-950 mbar'
  WAIT '30 s'
  VAL 'ciśnienie' 'mbar'
  MIN 'ciśnienie' '-1000 mbar'
  MAX 'ciśnienie' '-900 mbar'
  IF 'ciśnienie' < '-900'
  ELSE ERROR 'Nie osiągnięto wymaganej próżni'
  SET 'pompa próżniowa' '0'
GOAL: Test niskiego ciśnienia
  SET 'pompa ciśnieniowa' '1'
  SET 'target_niskie' '30 mbar'
  WAIT '10 s'
  VAL 'cn' 'mbar'
  MIN 'cn' '25 mbar'
  MAX 'cn' '35 mbar'
  IF 'cn' < '25' OR 'cn' > '35'
  ELSE ERROR 'Ciśnienie poza zakresem niskim'
GOAL: Test wysokiego ciśnienia
  SET 'zakres' 'wysoki'
  SET 'target_wysokie' '500 mbar'
  WAIT '10 s'
  VAL 'cw' 'mbar'
  MIN 'cw' '480 mbar'
  MAX 'cw' '520 mbar'
  IF 'cw' < '480' OR 'cw' > '520'
  ELSE ERROR 'Ciśnienie poza zakresem wysokim'
  SET 'pompa ciśnieniowa' '0'
  SET 'zawór izolacyjny' '0'
GOAL: Podsumowanie
  FUNC 'zakres_dynamiki' = 'SUB' 'cw,cn'
  SAVE 'zakres_dynamiki' 'raport'
  SET 'raport pełny' '1'
