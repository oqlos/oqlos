SCENARIO: PSS 7000 — Test przez maskę

GOAL test-wizualny:
  LOG "Inspekcja wizualna aparatu"
  SAVE wynik-wizualny

GOAL podłącz-złącza-sc:
  LOG "Akcja manualna: podłącz złącza SC"

GOAL otwórz-zawór-butli:
  SET zawór-butli-300bar 1

GOAL załóż-maskę:
  LOG "Akcja manualna: załóż maskę"

GOAL podłącz-automat-oddechowy:
  LOG "Akcja manualna: podłącz automat oddechowy"

GOAL test-statyczny-sc:
  SET pump-main 0
  WAIT 3s
  GET AI02
  SAVE ciśnienie-sc
  CHECK 6.0 <= AI02 <= 8.0 bar
  CORRECT 'Ciśnienie SC w normie (6-8 bar)'
  ERROR 'Błąd: ciśnienie SC poza zakresem 6-8 bar'

GOAL zmiana-sc:
  SET pump-main 0
  WAIT 60s
  GET AI02
  SAVE delta-ciśnienia-sc
  CHECK -0.3 <= AI02 <= 0.6 bar
  CORRECT 'Delta ciśnienia SC w normie'
  ERROR 'Błąd: przekroczona delta ciśnienia SC (dopuszczalna -0.3 do 0.6 bar)'

GOAL ciśnienie-otwarcia-automatu:
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 8s
  GET AI01
  SAVE ciśnienie-nc-min
  CHECK -29.0 <= AI01 <= -5.0 mbar
  CORRECT 'Ciśnienie otwarcia automatu w normie'
  ERROR 'Błąd: ciśnienie otwarcia automatu poza zakresem -29 do -5 mbar'

GOAL test-nadciśnienia-statycznego:
  SET pump-main 0
  WAIT 10s
  GET nadciśnienie
  SAVE nadciśnienie
  CHECK 2.0 <= nadciśnienie <= 3.9 mbar
  CORRECT 'Nadciśnienie statyczne w normie (2.0-3.9 mbar)'
  ERROR 'Błąd: nadciśnienie poza zakresem 2.0-3.9 mbar'

GOAL zamknij-zawór-butli:
  SET zawór-butli-300bar 0

GOAL test-szczelności-wc:
  SET pump-main 0
  WAIT 5s

GOAL kontrola-spadku-wc:
  WAIT 60s
  SAVE czas-pomiaru

GOAL test-sygnału-akustycznego:
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 2s
  GET AI01
  SAVE wynik-sygnału
  MIN AI01 0.0 mbar

GOAL wyłącz-automat-oddechowy:
  SET automat-oddechowy 0

GOAL wytworzenie-podciśnienia:
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 20s
  GET AI01
  CHECK -10.0 <= AI01 <= 10.0 mbar
  CORRECT 'Podciśnienie w normie (-10 do 10 mbar)'
  ERROR 'Błąd: podciśnienie poza zakresem -10 do 10 mbar'

GOAL szczelność-automatu-start:
  SET pump-main 0
  SET valve-bo04 1
  WAIT 15s
  GET AI01
  SAVE ciśnienie-nc-początkowe
  MAX AI01 -7.5 mbar

GOAL szczelność-automatu-koniec:
  WAIT 60s
  GET AI01
  SAVE ciśnienie-nc-końcowe
  MAX AI01 -6.5 mbar
