GOAL: Test wizualny aparatu
  VAL 'wynik' 'OK/NOK'
  SAVE 'wynik'
GOAL: Podłącz złącza SC
GOAL: Otwórz zawór butli
  SET 'zawór butli 300 bar' '1'
GOAL: Załóż maskę
GOAL: Podłącz automat oddechowy
GOAL: Test statyczny średniego ciśnienia
  SET 'PUMP' 'off'
  SET 'timeout' '3 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'ciśnienie SC' '6.0 bar'
  MAX 'ciśnienie SC' '8.0 bar'
  VAL 'ciśnienie SC' 'bar'
  SAVE 'ciśnienie SC'
GOAL: Zmiana średniego ciśnienia
  SET 'PUMP' 'off'
  SET 'czas pomiaru' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas pomiaru'
  MIN 'delta ciśnienia SC' '-0.3 bar'
  MAX 'delta ciśnienia SC' '0.6 bar'
  VAL 'delta ciśnienia SC' 'bar'
  SAVE 'delta ciśnienia SC'
GOAL: Ciśnienie otwarcia automatu oddechowego
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  SET 'timeout' '8 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'ciśnienie NC' '-29.0 mbar'
  MAX 'ciśnienie NC' '-5.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
  SAVE 'ciśnienie NC min'
GOAL: Test nadciśnienia statycznego
  SET 'PUMP' 'off'
  SET 'timeout' '10 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'nadciśnienie' '2.0 mbar'
  MAX 'nadciśnienie' '3.9 mbar'
  VAL 'nadciśnienie' 'mbar'
  SAVE 'nadciśnienie'
GOAL: Zamknij zawór butli
  SET 'zawór butli 300 bar' '0'
GOAL: Test szczelności układu WC
  SET 'PUMP' 'off'
  SET 'czas obserwacji' '5 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas obserwacji'
GOAL: Kontrola spadku ciśnienia
  SET 'czas pomiaru' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas pomiaru'
  SAVE 'czas pomiaru'
GOAL: Test sygnału akustycznego
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  MIN 'ciśnienie NC' '0.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
  SAVE 'wynik sygnału'
GOAL: Wyłącz automat oddechowy
  SET 'automat oddechowy' 'off'
GOAL: Wytworzenie podciśnienia
  SET 'PUMP' '5l'
  SET 'zawór BO06' '1'
  SET 'timeout' '20 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MIN 'ciśnienie NC' '-10.0 mbar'
  MAX 'ciśnienie NC' '10.0 mbar'
  VAL 'ciśnienie NC' 'mbar'
GOAL: Test szczelności automatu - pomiar początkowy
  SET 'PUMP' 'off'
  SET 'zawór BO04' '1'
  SET 'timeout' '15 s'
  SET 'timer' '0 s'
  IF 'timer' > 'timeout'
  MAX 'ciśnienie NC początkowe' '-7.5 mbar'
  VAL 'ciśnienie NC' 'mbar'
GOAL: Test szczelności automatu - pomiar końcowy
  SET 'czas stabilizacji' '60 s'
  SET 'timer' '0 s'
  SET 'WAIT' 'timer = czas stabilizacji'
  MAX 'ciśnienie NC końcowe' '-6.5 mbar'
  VAL 'ciśnienie NC' 'mbar'
  IF 'ciśnienie NC' > '-6.5 mbar'
  SAVE 'ciśnienie NC'
