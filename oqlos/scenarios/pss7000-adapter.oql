SCENARIO: PSS 7000 — Test przez adapter

GOAL:
  SET NAME 'Test wizualny'
  LOG "Inspekcja wizualna aparatu"
  SAVE wynik-wizualny

GOAL:
  SET NAME 'Podłącz złącza SC'
  LOG "Akcja manualna: podłącz złącza średniego ciśnienia"

GOAL:
  SET NAME 'Otwórz zawór butli'
  LOG "Akcja manualna: otwórz zawór butli"

GOAL:
  SET NAME 'Podłącz adapter'
  LOG "Akcja manualna: podłącz adapter"

GOAL:
  SET NAME 'Podłącz automat oddechowy'
  LOG "Akcja manualna: podłącz automat oddechowy"

GOAL:
  SET NAME 'Test statyczny SC'
  SET pump-main 0
  WAIT 3s
  GET AI02
  SAVE ciśnienie-sc
  IF AI02 6.0 .. 8.0 bar
  CORRECT 'Ciśnienie SC w normie (6-8 bar) - adapter'
  ERROR 'Błąd: ciśnienie SC poza zakresem 6-8 bar (adapter)'

GOAL:
  SET NAME 'Zmiana SC po 1 min'
  SET pump-main 0
  WAIT 60s
  GET AI02
  SAVE delta-ciśnienia-sc
  IF AI02 -0.3 .. 0.6 bar
  CORRECT 'Delta ciśnienia SC w normie (adapter)'
  ERROR 'Błąd: przekroczona delta ciśnienia SC (adapter)'

GOAL:
  SET NAME 'Ciśnienie otwarcia automatu'
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 8s
  GET AI01
  SAVE ciśnienie-nc-min
  IF AI01 -29.0 .. -5.0 mbar
  CORRECT 'Ciśnienie otwarcia automatu w normie (adapter)'
  ERROR 'Błąd: ciśnienie otwarcia poza zakresem (adapter)'

GOAL:
  SET NAME 'Test nadciśnienia statycznego'
  SET pump-main 0
  WAIT 10s
  GET nadciśnienie
  SAVE nadciśnienie
  IF nadciśnienie 2.0 .. 3.9 mbar
  CORRECT 'Nadciśnienie statyczne w normie (adapter)'
  ERROR 'Błąd: nadciśnienie poza zakresem (adapter)'

GOAL:
  SET NAME 'Zamknij zawór butli'
  SET zawór-butli-300bar 0

GOAL:
  SET NAME 'Test szczelności WC'
  SET pump-main 0
  WAIT 5s
  SAVE wynik-operatora

GOAL:
  SET NAME 'Kontrola spadku WC'
  WAIT 60s
  GET spadek-ciśnienia
  SAVE spadek-ciśnienia
  IF spadek-ciśnienia 0.0 .. 10.0 bar
  CORRECT 'Spadek WC w normie'
  ERROR 'Błąd: spadek WC poza zakresem'

GOAL:
  SET NAME 'Test sygnału akustycznego'
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 2s
  GET AI01
  SAVE wynik-sygnału
  IF AI01 0.0 .. 1.0 mbar
  CORRECT 'Sygnał akustyczny OK'
  ERROR 'Błąd: sygnał akustyczny poza zakresem'

GOAL:
  SET NAME 'Wyłącz automat oddechowy'
  SET automat-oddechowy 0

GOAL:
  SET NAME 'Wytworzenie nadciśnienia'
  SET pump-main 5.0 l/min
  SET valve-bo05 1
  WAIT 20s
  GET AI01
  IF AI01 0.0 .. 12.0 mbar
  CORRECT 'Nadciśnienie w normie'
  ERROR 'Błąd: nadciśnienie poza zakresem'

GOAL:
  SET NAME 'Szczelność automatu start'
  SET pump-main 0
  SET valve-bo04 1
  WAIT 15s
  GET AI01
  SAVE ciśnienie-nc-początkowe
  IF AI01 7.5 .. 9.0 mbar
  CORRECT 'Szczelność automatu start OK'
  ERROR 'Błąd: szczelność automatu start poza zakresem'

GOAL:
  SET NAME 'Szczelność automatu koniec'
  WAIT 60s
  GET AI01
  SAVE ciśnienie-nc-końcowe
  IF AI01 6.5 .. 8.0 mbar
  CORRECT 'Szczelność automatu koniec OK'
  ERROR 'Błąd: szczelność automatu koniec poza zakresem'
