SCENARIO: PSS 7000 — Test przez adapter

GOAL test-wizualny:
  LOG "Inspekcja wizualna aparatu"
  SAVE wynik-wizualny

GOAL podłącz-złącza-sc:
  LOG "Akcja manualna: podłącz złącza średniego ciśnienia"

GOAL otwórz-zawór-butli:
  LOG "Akcja manualna: otwórz zawór butli"

GOAL podłącz-adapter:
  LOG "Akcja manualna: podłącz adapter"

GOAL podłącz-automat-oddechowy:
  LOG "Akcja manualna: podłącz automat oddechowy"

GOAL test-statyczny-sc:
  SET pump-main 0
  WAIT 3s
  GET AI02
  SAVE ciśnienie-sc
  CHECK 6.0 <= AI02 <= 8.0 bar
  CORRECT 'Ciśnienie SC w normie (6-8 bar) - adapter'
  ERROR 'Błąd: ciśnienie SC poza zakresem 6-8 bar (adapter)'

GOAL zmiana-sc-po-1-min:
  SET pump-main 0
  WAIT 60s
  GET AI02
  SAVE delta-ciśnienia-sc
  CHECK -0.3 <= AI02 <= 0.6 bar
  CORRECT 'Delta ciśnienia SC w normie (adapter)'
  ERROR 'Błąd: przekroczona delta ciśnienia SC (adapter)'

GOAL ciśnienie-otwarcia-automatu:
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 8s
  GET AI01
  SAVE ciśnienie-nc-min
  CHECK -29.0 <= AI01 <= -5.0 mbar
  CORRECT 'Ciśnienie otwarcia automatu w normie (adapter)'
  ERROR 'Błąd: ciśnienie otwarcia poza zakresem (adapter)'

GOAL test-nadciśnienia-statycznego:
  SET pump-main 0
  WAIT 10s
  GET nadciśnienie
  SAVE nadciśnienie
  CHECK 2.0 <= nadciśnienie <= 3.9 mbar
  CORRECT 'Nadciśnienie statyczne w normie (adapter)'
  ERROR 'Błąd: nadciśnienie poza zakresem (adapter)'

GOAL zamknij-zawór-butli:
  SET zawór-butli-300bar 0

GOAL test-szczelności-wc:
  SET pump-main 0
  WAIT 5s
  SAVE wynik-operatora

GOAL kontrola-spadku-wc:
  WAIT 60s
  GET spadek-ciśnienia
  SAVE spadek-ciśnienia
  MAX spadek-ciśnienia 10 bar

GOAL test-sygnału-akustycznego:
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 2s
  GET AI01
  SAVE wynik-sygnału
  MIN AI01 0.0 mbar

GOAL wyłącz-automat-oddechowy:
  SET automat-oddechowy 0

GOAL wytworzenie-nadciśnienia:
  SET pump-main 5.0 l/min
  SET valve-bo05 1
  WAIT 20s
  GET AI01
  MAX AI01 12.0 mbar

GOAL szczelność-automatu-start:
  SET pump-main 0
  SET valve-bo04 1
  WAIT 15s
  GET AI01
  SAVE ciśnienie-nc-początkowe
  MIN AI01 7.5 mbar

GOAL szczelność-automatu-koniec:
  WAIT 60s
  GET AI01
  SAVE ciśnienie-nc-końcowe
  MIN AI01 6.5 mbar
