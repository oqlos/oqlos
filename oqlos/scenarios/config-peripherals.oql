VERSION: 4
SCENARIO: Konfiguracja Peryferii
DEVICE_TYPE: BA
DEVICE_MODEL: PSS 7000
MANUFACTURER: Dräger

INCLUDE 'lib/peripherals.oql'

# ──────────────────────────────────────────────
# INIT — peryferia do znanego stanu bezpiecznego
# ──────────────────────────────────────────────

CONFIG init-pompa:
  CALL init-pump

CONFIG init-zawory-nc:
  SET 'valve-nc' '0'
  SET WAIT '300 ms'
CONFIG init-zawory-sc:
  SET 'valve-sc' '0'
  SET WAIT '300 ms'
CONFIG init-zawory-wc:
  SET 'valve-wc' '0'
  SET WAIT '300 ms'
CONFIG init-zawory-numerowane:
  CALL init-valves-numbered

CONFIG init-czujniki:
  GET AI01
  SAVE baseline-AI01
  GET AI02
  SAVE baseline-AI02
  GET AI03
  SAVE baseline-AI03

# ──────────────────────────────────────────────
# VERIFY — weryfikacja przez re-send komend
# ──────────────────────────────────────────────

CONFIG verify-zawory-zamkniete:
  SET 'valve-nc' '0'
  SET 'valve-sc' '0'
  SET 'valve-wc' '0'
  SET WAIT '200 ms'
  SAVE zawory-zamkniete

CONFIG verify-pompa-wylaczona:
  CALL init-pump
  SAVE pompa-wylaczona

# ──────────────────────────────────────────────
# STATE / TRYBY — tryby pracy systemu
# ──────────────────────────────────────────────

GOAL:
  SET NAME 'state ready'
  LOG 'System gotowy do pracy'
  SAVE system-ready
  SET WAIT '1 s'
GOAL:
  SET NAME 'tryb kalibracji'
  SET 'valve-nc' '1'
  SET 'valve-sc' '1'
  SET 'valve-wc' '1'
  SET WAIT '1 s'
  SET 'valve-nc' '0'
  SET 'valve-sc' '0'
  SET 'valve-wc' '0'
  SAVE kalibracja-zakonczona

GOAL:
  SET NAME 'tryb testowy pompy'
  SET 'pompa-1' '5 l/min'
  SET WAIT '2 s'
  SET 'pompa-1' '0'
  SAVE test-pompy-ok
