SCENARIO: PSS 7000 z maską FENZY ZENITH

GOAL test-wizualny:
  LOG "Inspekcja wizualna aparatu"
  SAVE wynik-wizualny

GOAL podłącz-złącza-sc:
  LOG "Akcja manualna: podłącz złącza SC"

GOAL odkręć-zawór-butli:
  SET zawór-butli-300bar 1

GOAL załóż-maskę:
  LOG "Akcja manualna: załóż maskę FENZY ZENITH"

GOAL test-statyczny-sc:
  SET pump-main 0
  WAIT 3s
  GET AI02
  SAVE ciśnienie-sc
  CHECK 6.0 <= AI02 <= 8.0 bar
  CORRECT 'Ciśnienie SC w normie (FENZY ZENITH)'
  ERROR 'Błąd: ciśnienie SC poza zakresem (FENZY ZENITH)'

GOAL zmiana-sc:
  WAIT 6s
  GET AI01
  SAVE delta-ciśnienia-sc
  CHECK -1.0 <= AI01 <= 0.5 bar
  CORRECT 'Delta ciśnienia w normie (FENZY ZENITH)'
  ERROR 'Błąd: przekroczona delta ciśnienia (FENZY ZENITH)'

GOAL zamknij-zawór-butli:
  SET zawór-butli-300bar 0

GOAL test-szczelności-wc:
  SET pump-main 0
  WAIT 5s

GOAL kontrola-spadku-wc:
  WAIT 10s
  GET AI01
  SAVE spadek-ciśnienia
  MAX AI01 3 bar

GOAL podłącz-automat-oddechowy:
  LOG "Akcja manualna: podłącz automat oddechowy"

GOAL test-nadciśnienia-statycznego:
  SET pump-main 0
  WAIT 5s
  GET AI01
  SAVE nadciśnienie
  CHECK 2.2 <= AI01 <= 4.1 mbar
  CORRECT 'Nadciśnienie statyczne w normie (FENZY ZENITH)'
  ERROR 'Błąd: nadciśnienie poza zakresem (FENZY ZENITH)'

GOAL test-sygnału-akustycznego:
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 2s
  GET AI01
  SAVE wynik-sygnału
  MIN AI01 0.0 mbar

GOAL wytworzenie-podciśnienia:
  SET pump-main 5.0 l/min
  SET valve-bo06 1
  WAIT 20s
  GET AI01
  CHECK -12.0 <= AI01 <= 12.0 mbar
  CORRECT 'Podciśnienie w normie (FENZY ZENITH)'
  ERROR 'Błąd: podciśnienie poza zakresem (FENZY ZENITH)'

GOAL ustawienie-auto:
  SET pump-main 0
  SET valve-bo04 1
  WAIT 15s
  GET AI01
  MAX AI01 -6.0 mbar

GOAL test-szczelności-automatu:
  WAIT 5s
  GET AI01
  SAVE ciśnienie-nc-końcowe
  MAX AI01 -4.0 mbar
