# OqlOS Service Configuration Example
# Copy this file to .env and adjust values as needed

# Server Configuration
FIRMWARE_PORT=8202
SERVICE_NAME=firmware-simulator
SERVICE_VERSION=0.1.0

# Hardware Mode (mock | real)
HARDWARE_MODE=mock

# Modbus RTU Configuration
MODBUS_SERIAL_PORT=/dev/ttyACM1
MODBUS_BAUD=19200
MODBUS_PARITY=N
MODBUS_DEVICE_ID=1

# Modbus TCP Fallback
MODBUS_HOST=localhost
MODBUS_PORT=502

# Hardware Service URLs
PIADC_URL=http://localhost:8080
MOTOR_URL=http://localhost:49055

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# CORS Settings (comma-separated origins or * for all)
CORS_ORIGINS=*
