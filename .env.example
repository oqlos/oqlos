# OqlOS Service Configuration Example
# Copy this file to .env and adjust values as needed
# Preferred naming uses OQLOS_* variables.
# Legacy non-prefixed names are still accepted for backward compatibility.

# Server Configuration
OQLOS_FIRMWARE_PORT=8202
OQLOS_SERVICE_NAME=firmware-simulator
OQLOS_SERVICE_VERSION=0.1.0

# Hardware Mode (mock | real)
OQLOS_HARDWARE_MODE=mock

# Modbus RTU Configuration
OQLOS_MODBUS_SERIAL_PORT=/dev/ttyACM1
OQLOS_MODBUS_BAUD=19200
OQLOS_MODBUS_PARITY=N
OQLOS_MODBUS_DEVICE_ID=1

# Modbus TCP Fallback
OQLOS_MODBUS_HOST=localhost
OQLOS_MODBUS_PORT=502

# Hardware Service URLs
OQLOS_PIADC_URL=http://localhost:8080
OQLOS_MOTOR_URL=http://localhost:49055
OQLOS_LUNG_MOTOR_URL=http://localhost:8205

# Pump Calibration
# Flow rate that maps to 100% PWM for `pompa 1`
OQLOS_PUMP_FLOW_FULL_SCALE_LPM=10

# Logging (DEBUG | INFO | WARNING | ERROR)
OQLOS_LOG_LEVEL=INFO

# CORS Settings (comma-separated origins or * for all)
OQLOS_CORS_ORIGINS=*
