VERSION: 4
SCENARIO: "Test DSL Loops"
DEVICE_TYPE: "Simulator"

GOAL:
  SET NAME [Verify loop execution]
    # Counted loop
    VAR counter = "0"
REPEAT 3:
  SET Pump 10 l/min
        # Wait or other actions
REPEAT STOP
    
    # Conditional loop
    # Dry-run condition simulation
    LOOP WHILE 'AI01' < '0.0 mbar'
  SET Valve 1 (open)
  WAIT 1.0 s
REPEAT STOP
