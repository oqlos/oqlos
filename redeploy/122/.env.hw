# OqlOS hardware-node environment (boardnet / 192.168.188.122).
# Deployed to /home/pi/maskservice/config/oql-mqtt.env and loaded by the
# oqlos-hardware-api systemd --user unit (EnvironmentFile=).
#
# DO NOT commit a real password. Set OQLOS_OQL_MQTT_PASSWORD here on the Pi only,
# matching the mosquitto.passwd entry created with `mosquitto_passwd`.

# Hardware runtime
OQLOS_HARDWARE_MODE=real

# StackNet control identity. Replace on BoardNet only; deploy preserves the
# private ~/maskservice/config/oql-mqtt.env after its first creation.
MASKAUTH_BOARDNET_CLIENT_SECRET=CHANGE_ME_ON_PI

# OQL-over-MQTT transport — this node is both:
# - AGENT: executes OQL locally on boardnet
# - CONTROLLER: lets the local HTTP API (/api/v1/oql/*) send to the agent
OQLOS_OQL_TRANSPORT_ROLE=both
OQLOS_OQL_NODE_ID=boardnet
OQLOS_OQL_TOPIC_PREFIX=oqlos/c2004

# Broker runs locally on this Pi (loopback for the agent; LAN-exposed for pi109).
OQLOS_OQL_MQTT_HOST=127.0.0.1
OQLOS_OQL_MQTT_PORT=1883
OQLOS_OQL_MQTT_USERNAME=oqlos
OQLOS_OQL_MQTT_PASSWORD=CHANGE_ME_ON_PI

# Must match the token provisioned locally on StackNet. Keep the real value
# only in /home/pi/maskservice/config/oql-mqtt.env on BoardNet.
STACKNET_OQL_TOKEN=
